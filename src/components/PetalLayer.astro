---
// Decorative falling sakura / momiji behind the page.
// Pieces are generated here at build time from a fixed seed, so the page ships
// no animation JS: CSS animates `transform` only. The season is chosen by the
// inline script in Base.astro via <html data-season>; without JS it stays sakura.

const COUNT = 14;
const PINKS = ['#F7C6D0', '#F4B8C5', '#F9D5DD', '#EFA8B8'];
const REDS = ['#C8432B', '#D9653B', '#E08A3C', '#B8452E'];

let seed = 7;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;

const makePieces = (leaf: boolean) =>
  Array.from({ length: COUNT }, () => {
    const size = leaf ? 14 + rnd() * 12 : 10 + rnd() * 9;
    const dur = 16 + rnd() * 16;
    const depth = rnd(); // far pieces are smaller, fainter, slightly blurred
    const style = [
      `--x:${(rnd() * 100).toFixed(1)}%`,
      `--s:${(size * (0.7 + depth * 0.5)).toFixed(1)}px`,
      `--dur:${dur.toFixed(1)}s`,
      `--delay:-${(rnd() * dur).toFixed(1)}s`,
      `--drift:${(-80 + rnd() * 160).toFixed(0)}px`,
      `--rot:${(120 + rnd() * 300).toFixed(0)}deg`,
      `--flut:${(2.5 + rnd() * 3).toFixed(1)}s`,
      `--o:${(0.35 + depth * 0.35).toFixed(2)}`,
      `--b:${depth < 0.3 ? 1 : 0}px`,
    ].join(';');
    return { style, color: (leaf ? REDS : PINKS)[Math.floor(rnd() * 4)] };
  });

const petals = makePieces(false);
const leaves = makePieces(true);
---

<div class="petal-layer" aria-hidden="true">
  <svg class="petal-branch" viewBox="0 0 440 300" fill="none">
    <defs>
      <g id="pl-flower">
        <ellipse cx="0" cy="-7" rx="5" ry="7.5" />
        <ellipse cx="0" cy="-7" rx="5" ry="7.5" transform="rotate(72)" />
        <ellipse cx="0" cy="-7" rx="5" ry="7.5" transform="rotate(144)" />
        <ellipse cx="0" cy="-7" rx="5" ry="7.5" transform="rotate(216)" />
        <ellipse cx="0" cy="-7" rx="5" ry="7.5" transform="rotate(288)" />
        <circle r="2.6" fill="#D9718A" />
      </g>
      <path id="pl-maple" transform="translate(-12 -12)" d="M12 1 L13.6 6.2 L17 4.5 L16 9 L21 8.2 L18.6 12 L22 14 L16.2 14.6 L16.8 18 L12.8 16 L12.6 23 L11.4 23 L11.2 16 L7.2 18 L7.8 14.6 L2 14 L5.4 12 L3 8.2 L8 9 L7 4.5 L10.4 6.2 Z" />
    </defs>
    <!-- sumi-e branch strokes -->
    <path d="M440 18 C380 30 330 52 280 88 C240 116 200 132 150 140" stroke="#6B5B53" stroke-width="5" stroke-linecap="round" opacity=".55" />
    <path d="M300 74 C290 110 300 150 320 190" stroke="#6B5B53" stroke-width="3" stroke-linecap="round" opacity=".5" />
    <path d="M220 122 C200 150 170 170 120 182" stroke="#6B5B53" stroke-width="2.5" stroke-linecap="round" opacity=".45" />
    <path d="M370 40 C360 70 368 96 384 120" stroke="#6B5B53" stroke-width="2.5" stroke-linecap="round" opacity=".45" />
    <g class="petal-blossoms" fill="#F4B8C5">
      <use href="#pl-flower" transform="translate(150 140)" />
      <use href="#pl-flower" transform="translate(120 182) scale(.8)" />
      <use href="#pl-flower" transform="translate(232 118) scale(.9)" />
      <use href="#pl-flower" transform="translate(320 190) scale(.85)" />
      <use href="#pl-flower" transform="translate(300 120) scale(.7)" />
      <use href="#pl-flower" transform="translate(384 120) scale(.75)" />
      <use href="#pl-flower" transform="translate(345 52) scale(.65)" />
      <use href="#pl-flower" transform="translate(190 158) scale(.55)" />
    </g>
    <g class="petal-maples">
      <use href="#pl-maple" fill="#D9653B" transform="translate(138 128) rotate(-20) scale(1.1)" />
      <use href="#pl-maple" fill="#C8432B" transform="translate(310 178) rotate(10)" />
      <use href="#pl-maple" fill="#C8432B" transform="translate(108 172) rotate(15)" />
      <use href="#pl-maple" fill="#E08A3C" transform="translate(222 108) rotate(-35) scale(.95)" />
      <use href="#pl-maple" fill="#D9653B" transform="translate(374 108) rotate(-10) scale(.85)" />
      <use href="#pl-maple" fill="#E08A3C" transform="translate(335 42) rotate(25) scale(.8)" />
    </g>
  </svg>

  <div class="petal-set petal-set--sakura">
    {petals.map((p) => (
      <div class="petal-piece" style={p.style}>
        <svg viewBox="0 0 24 24">
          <path fill={p.color} d="M12 3.5 L10.2 1 C4.5 4.5 2.5 12 7 18 Q12 22.5 17 18 C21.5 12 19.5 4.5 13.8 1 Z" />
        </svg>
      </div>
    ))}
  </div>
  <div class="petal-set petal-set--momiji">
    {leaves.map((p) => (
      <div class="petal-piece" style={p.style}>
        <svg viewBox="0 0 24 24">
          <path fill={p.color} d="M12 1 L13.6 6.2 L17 4.5 L16 9 L21 8.2 L18.6 12 L22 14 L16.2 14.6 L16.8 18 L12.8 16 L12.6 23 L11.4 23 L11.2 16 L7.2 18 L7.8 14.6 L2 14 L5.4 12 L3 8.2 L8 9 L7 4.5 L10.4 6.2 Z" />
        </svg>
      </div>
    ))}
  </div>
</div>

<button type="button" class="petal-toggle" aria-pressed="false" aria-label="Pause falling petals" title="Pause falling petals">
  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
    <path class="petal-toggle-shape" d="M12 3.5 L10.2 1 C4.5 4.5 2.5 12 7 18 Q12 22.5 17 18 C21.5 12 19.5 4.5 13.8 1 Z" />
    <g class="petal-toggle-pause" fill="currentColor">
      <rect x="8.5" y="8" width="2.4" height="8" rx="1" />
      <rect x="13.1" y="8" width="2.4" height="8" rx="1" />
    </g>
    <path class="petal-toggle-play" fill="currentColor" d="M9.5 7.8 L16.5 12 L9.5 16.2 Z" />
  </svg>
</button>

<style is:global>
.petal-layer {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}

/* Soft vermilion sun wash behind the branch */
.petal-layer::before {
  content: '';
  position: absolute;
  width: 520px;
  height: 520px;
  top: -180px;
  right: -140px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 67, 43, 0.07), transparent 65%);
}

.petal-branch {
  position: absolute;
  top: -10px;
  right: -20px;
  width: min(440px, 55vw);
  opacity: 0.55;
}

.petal-piece {
  position: absolute;
  top: -6vh;
  left: var(--x);
  width: var(--s);
  height: var(--s);
  animation: petal-fall var(--dur) linear var(--delay) infinite;
}
.petal-piece svg {
  display: block;
  width: 100%;
  height: 100%;
  opacity: var(--o);
  filter: blur(var(--b));
  animation: petal-flutter var(--flut) ease-in-out var(--delay) infinite alternate;
}

@keyframes petal-fall {
  0%   { transform: translate3d(0, 0, 0); }
  50%  { transform: translate3d(var(--drift), 55vh, 0); }
  100% { transform: translate3d(calc(var(--drift) * -0.4), 112vh, 0); }
}
@keyframes petal-flutter {
  0%   { transform: rotate(0deg) rotateX(0deg); }
  100% { transform: rotate(var(--rot)) rotateX(65deg); }
}

/* ---- Seasons: spring (and no-JS) = sakura, autumn = momiji, rest = light mix ---- */
.petal-set--momiji,
.petal-maples {
  display: none;
}
html[data-season='autumn'] .petal-set--sakura,
html[data-season='autumn'] .petal-blossoms {
  display: none;
}
html[data-season='autumn'] .petal-set--momiji,
html[data-season='autumn'] .petal-maples,
html[data-season='mixed'] .petal-set--momiji,
html[data-season='mixed'] .petal-maples {
  display: block;
}
html[data-season='mixed'] .petal-piece:nth-child(n + 6),
html[data-season='mixed'] .petal-maples use:nth-child(n + 3) {
  display: none;
}

/* Half as many pieces on small screens */
@media (max-width: 700px) {
  .petal-piece:nth-child(n + 8) {
    display: none;
  }
  .petal-branch {
    width: 60vw;
    opacity: 0.4;
  }
}

/* ---- Pause: user toggle, or reduced motion (pieces freeze as a still scatter) ---- */
html.petals-paused .petal-piece,
html.petals-paused .petal-piece svg {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  .petal-piece,
  .petal-piece svg {
    animation-play-state: paused;
  }
}

.petal-toggle {
  position: fixed;
  right: var(--space-4);
  bottom: var(--space-4);
  z-index: 20;
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  padding: 0;
  border: 1px solid var(--border);
  border-radius: 50%;
  background: var(--surface);
  color: var(--ink-2);
  box-shadow: var(--shadow-card);
  cursor: pointer;
  transition: color 0.15s ease, border-color 0.15s ease;
}
.petal-toggle:hover {
  color: var(--ink);
  border-color: var(--border-strong);
}
.petal-toggle-shape {
  fill: #F4B8C5;
  opacity: 0.55;
}
html[data-season='autumn'] .petal-toggle-shape {
  fill: #E08A3C;
}
.petal-toggle-play,
html.petals-paused .petal-toggle-pause {
  display: none;
}
html.petals-paused .petal-toggle-play {
  display: inline;
}
/* Pieces are already still under reduced motion, so the toggle has nothing to do */
@media (prefers-reduced-motion: reduce) {
  .petal-toggle {
    display: none;
  }
}
</style>

<script>
  const KEY = 'petals-paused';
  const button = document.querySelector<HTMLButtonElement>('.petal-toggle');
  const root = document.documentElement;

  const render = () => {
    const paused = root.classList.contains('petals-paused');
    const label = paused ? 'Resume falling petals' : 'Pause falling petals';
    button?.setAttribute('aria-pressed', String(paused));
    button?.setAttribute('aria-label', label);
    button?.setAttribute('title', label);
  };

  button?.addEventListener('click', () => {
    const paused = root.classList.toggle('petals-paused');
    try {
      if (paused) localStorage.setItem(KEY, '1');
      else localStorage.removeItem(KEY);
    } catch {
      // Storage blocked: the toggle still works for this page view.
    }
    render();
  });

  render();
</script>
