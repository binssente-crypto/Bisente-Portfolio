---

<section class="route-map" data-route-map aria-labelledby="rm-heading">
  <!-- SKILLS SECTION (Kanban Style without outer container) -->
  <div class="skills-section">
    <div class="skills-header-row">
      <h3 class="skills-title">Skills</h3>
      <button
        type="button"
        class="view-all-skills-btn"
        data-action="toggle-skills"
        aria-expanded="false"
      >
        <span class="toggle-text">View all skills</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>

    <div class="kanban-grid" data-rm="chips" role="group" aria-label="Show entries that use a skill">
      {skillCategories.map((col) => (
        <div class="kanban-column" style={`--col-accent: ${col.color};`}>
          <div class="kanban-column-header">
            <span class="column-dot"></span>
            <span class="column-name">{col.name}</span>
            <span class="column-count">{col.skills.length}</span>
          </div>
          <div class="column-pills">
            {col.skills.map((sk) => (
              <button
                type="button"
                aria-pressed="false"
                data-skill={sk.slug}
                class={`skill-pill-btn ${sk.common ? 'is-common-skill' : 'is-extra-skill'}`}
                title={`Filter timeline by ${sk.name}`}
              >
                <!-- Compact inline SVG icons -->
                {sk.icon === 'js' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pill-icon js-icon">
                    <rect width="24" height="24" rx="3" fill="#F7DF1E"/>
