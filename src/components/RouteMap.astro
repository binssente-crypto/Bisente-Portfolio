                    <rect x="2" y="14" width="20" height="7" rx="2" fill="rgba(255,255,255,0.08)"/>
                    <line x1="6" y1="6.5" x2="6.01" y2="6.5" stroke="#38BDF8" stroke-width="3"/>
                    <line x1="6" y1="17.5" x2="6.01" y2="17.5" stroke="#38BDF8" stroke-width="3"/>
                  </svg>
                )}
                {sk.icon === 'laravel' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#FF2D20" class="pill-icon">
                    <path d="M12.6 1.8l8.3 4.8c.4.2.6.7.6 1.1v9.6c0 .5-.3.9-.7 1.1l-8.3 4.8c-.4.2-.9.2-1.3 0L2.9 18.4c-.4-.2-.7-.7-.7-1.1V7.7c0-.5.3-.9.7-1.1l8.3-4.8c.4-.2 1-.2 1.4 0zm-1.3 2.4L4.7 7.9 12 12.1l7.3-4.2-8-4.7z"/>
                  </svg>
                )}
                {sk.icon === 'django' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pill-icon">
                    <rect width="24" height="24" rx="4" fill="#092E20"/>
                    <path d="M13.2 5.5h2.4v9.2c0 2.2-1.1 3.5-3.3 3.5-1.1 0-2.1-.4-2.7-1l1.1-1.7c.4.4.9.7 1.5.7.9 0 1.3-.6 1.3-1.6V5.5zm-5 4.6c1.1 0 1.9.8 1.9 2.2v4.8H7.7v-4.4c0-.9-.4-1.3-1.1-1.3-.6 0-1.1.4-1.3.9v4.8H3V6.7h2.4v4.4c.6-.7 1.5-1 2.8-1z" fill="#44B78B"/>
                  </svg>
                )}
                {sk.icon === 'fastapi' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pill-icon">
                    <circle cx="12" cy="12" r="11" fill="#05998B"/>
                    <path d="M13 3L6 14h5l-2 7 9-12h-5z" fill="#FFF"/>
                  </svg>
                )}
                {sk.icon === 'api' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="pill-icon">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M8 12h8m-4-4v8"/>
                  </svg>
                )}
                {sk.icon === 'socket' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#00E5FF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="pill-icon">
                    <polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                )}
                {sk.icon === 'docker' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#2496ED" class="pill-icon">
                    <path d="M22 12c-.5-1.2-1.8-1.8-3-1.6-.2-1-.8-1.8-1.8-2.2-.2 0-.4-.1-.6-.1-.3-.6-.8-1.2-1.5-1.5l-.6-.2-.4.4c-.6.6-1 1.4-1.1 2.2H2v6c0 3.3 2.7 6 6 6h8c3.3 0 6-2.7 6-6v-3z"/>
                  </svg>
                )}
                {sk.icon === 'shield' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#00FF9D" stroke-width="2" class="pill-icon">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                )}
                {sk.icon === 'radar' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#00FF9D" stroke-width="2" class="pill-icon">
                    <circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10"/><line x1="12" y1="12" x2="19" y2="5"/>
