        </g>

        <!-- Station Waypoints -->
        <g class="rm-stations">
          {layout.stations.map((s) => (
            <g
              class={`rm-station rm-${s.line}`}
              data-key={s.key}
              data-shape={s.shape}
              data-x={s.x}
              data-y={s.y}
              data-skills={skillsOf(s.skills)}
              data-caption={s.caption}
              style={`--d:${s.delay}ms`}
            >
              <a href={s.href} tabindex="-1">
                {s.shape === 'circle' ? (
                  <circle cx={s.x} cy={s.y} r={s.hw} />
                ) : (
                  <rect
                    x={+(s.x - s.hw).toFixed(1)}
                    y={s.y - s.hh}
                    width={s.hw * 2}
                    height={s.hh * 2}
                    rx={s.shape === 'pill' ? s.hh : 4}
                  />
                )}
                {s.shape === 'pill' && (
                  <text
                    class="rm-pill-label"
                    x={s.x}
                    y={s.y + 4.5}
                    text-anchor="middle"
                  >
                    {s.label}
                  </text>
                )}
              </a>
            </g>
          ))}
        </g>

        <!-- Slanted Canvas Labels (/) -->
        <g class="rm-labels">
          {layout.stations
            .filter((s) => s.label && s.shape !== 'pill')
            .map((s) => (
              <text
                class="rm-label rm-slanted-label"
                x={s.x + 2}
                y={s.y - (s.hh + 8)}
                text-anchor="start"
                transform={`rotate(-58 ${s.x + 2} ${s.y - (s.hh + 8)})`}
                data-skills={skillsOf(s.skills)}
                style={`--d:${s.delay}ms`}
              >
                {s.label}
              </text>
