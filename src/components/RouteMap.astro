                {sk.icon === 'packet' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0EA5E9" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="pill-icon">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                )}
                {sk.icon === 'cisco' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#1BA0D7" class="pill-icon">
