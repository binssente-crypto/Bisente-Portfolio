                    <line x1="12" y1="9" x2="12" y2="13"/>
                    <line x1="12" y1="17" x2="12.01" y2="17"/>
                  </svg>
                )}
                {sk.icon === 'firewall' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#00FF9D" stroke-width="2" class="pill-icon">
                    <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="9"/><line x1="15" y1="9" x2="15" y2="15"/><line x1="9" y1="15" x2="9" y2="21"/>
                  </svg>
                )}
                {sk.icon === 'intel' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#A855F7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="pill-icon">
                    <circle cx="12" cy="12" r="9"/>
                    <line x1="12" y1="3" x2="12" y2="7"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                    <line x1="3" y1="12" x2="7" y2="12"/>
                    <line x1="17" y1="12" x2="21" y2="12"/>
