---
import { getCollection } from 'astro:content';
import { buildJourney, type Line, type MapEntry } from '../lib/route-map';

const [projects, credentials, notes] = await Promise.all([
  getCollection('projects'),
  getCollection('credentials'),
  getCollection('notes', ({ data }) => !data.draft),
]);

const entries: MapEntry[] = [
  ...projects.map((e): MapEntry => ({
    key: `projects/${e.id}`,
    line: 'projects',
    title: e.data.title,
    date: e.data.date,
    href: `/projects/${e.id}/`,
    skills: e.data.skills,
    related: e.data.related,
    featured: e.data.featured,
  })),
  ...credentials.map((e): MapEntry => ({
    key: `credentials/${e.id}`,
    line: 'learning',
    title: e.data.title,
    date: e.data.date,
    href: `/learning/#${e.id}`,
    skills: e.data.skills,
    related: e.data.related,
    cluster: e.data.cluster,
    highlight: e.data.highlight,
  })),
  ...notes.map((e): MapEntry => ({
    key: `notes/${e.id}`,
    line: 'notes',
    title: e.data.title,
    date: e.data.date,
    href: `/notes/${e.id}/`,
    skills: e.data.skills,
    related: e.data.related,
  })),
];

const journey = buildJourney(entries);
const busiest = Math.max(...journey.zones.map((z) => z.weight));
const laneTitle = Object.fromEntries(journey.lanes.map((l) => [l.line, l.title])) as Record<Line, string>;
const laneStops = (line: Line) => journey.stops.filter((s) => s.line === line);

const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/\+/g, 'plus')
    .replace(/#/g, 'sharp')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const skillsOf = (skills: string[]) => skills.map(slug).join(' ');

// Comprehensive Kanban-style skills grouped by category with SVG icons
