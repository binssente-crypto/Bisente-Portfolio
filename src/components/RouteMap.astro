                {sk.icon === 'vector' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#FFB13B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pill-icon">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                  </svg>
                )}
                {sk.icon === 'node' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#68A063" class="pill-icon">
                    <path d="M12 2l9 5.2v10.4L12 22.8 3 17.6V7.2L12 2z"/>
                  </svg>
                )}
                {sk.icon === 'server' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#E2E8F0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pill-icon">
