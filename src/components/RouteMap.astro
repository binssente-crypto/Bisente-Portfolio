/* ---- MOBILE: VERTICAL STRIP MAP ---- */
.jr-mobile {
  display: none;
  overflow: clip;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.jm-year-title {
  position: sticky;
  top: 0;
  z-index: 2;
  margin: 0;
  padding: 0.45rem var(--space-4);
  background: var(--paper);
  border-block: 1px solid var(--border);
  font-size: 1rem;
  font-weight: 700;
}
.jm-year:first-child .jm-year-title {
  border-top: 0;
}

.jm-list {
  margin: 0;
  padding: 0;
  list-style: none;
}

.jm-link {
  display: flex;
  align-items: stretch;
  min-height: 56px;
  color: var(--ink);
  text-decoration: none;
  transition: opacity 0.2s ease, background 0.15s ease;
}
.jm-link:hover {
  background: var(--surface-2);
}

/* Three thin rails; each stop sits on its own lane's rail */
.jm-rails {
  position: relative;
  flex: 0 0 60px;
  background:
    linear-gradient(var(--projects), var(--projects)) 15px 0 / 3px 100% no-repeat,
    linear-gradient(var(--learning), var(--learning)) 29px 0 / 3px 100% no-repeat,
    repeating-linear-gradient(to bottom, var(--notes) 0 6px, transparent 6px 10px) 43px 0 / 3px 100% no-repeat;
}
.rm-projects .jm-mark { --rx: 16.5px; }
.rm-learning .jm-mark { --rx: 30.5px; }
.rm-notes .jm-mark { --rx: 44.5px; }

.jm-mark {
  position: absolute;
  left: var(--rx);
  top: 50%;
  box-sizing: border-box;
  width: 14px;
  height: 14px;
  background: var(--surface);
  border: 3px solid var(--lane);
  transform: translate(-50%, -50%);
}
.jm-mark--dot { border-radius: 50%; }
.jm-mark--square { border-radius: 3px; }
.jm-mark--pill { width: 14px; height: 20px; border-radius: 999px; background: color-mix(in srgb, var(--lane) 25%, var(--surface)); }

.jm-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0.55rem 0;
}
.jm-row + .jm-row .jm-text,
.jm-row + .jm-row .jm-chevron {
  border-top: 1px solid var(--border);
}
.jm-title {
  font-size: 0.95rem;
  font-weight: 700;
  line-height: 1.3;
}
.jm-meta {
