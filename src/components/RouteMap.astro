<style is:global>
.route-map {
  color: var(--ink);
  font-family: var(--font);
}

.rm-projects { --lane: var(--projects); --lane-text: var(--projects-text); --glow: var(--projects-glow); }
.rm-learning { --lane: var(--learning); --lane-text: var(--learning-text); --glow: var(--learning-glow); }
.rm-notes    { --lane: var(--notes);    --lane-text: var(--notes-text);    --glow: var(--notes-glow); }

.rm-top-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
}

.rm-section-title {
  margin: 0;
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.jr-legend {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.jr-legend-item {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.25rem 0.65rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--lane) 9%, var(--surface));
  color: var(--lane-text);
  font-size: 0.82rem;
  font-weight: 700;
}

.jr-legend-swatch {
  width: 9px;
  height: 9px;
  border-radius: 2px;
  background: var(--lane);
}

.jr-legend-count {
  color: var(--ink-3);
  font-weight: 600;
}

/* ---- DESKTOP: YEAR-ZONE METRO MAP ---- */
.jr-desktop {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.jr-scroll {
  overflow-x: auto;
  padding: var(--space-4) var(--space-4) var(--space-5);
  border-radius: inherit;
}

.jr-scroll.can-scroll-right {
  mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
}
.jr-scroll.can-scroll-left {
  mask-image: linear-gradient(to right, transparent, #000 32px);
}
.jr-scroll.can-scroll-left.can-scroll-right {
  mask-image: linear-gradient(to right, transparent, #000 32px, #000 calc(100% - 32px), transparent);
}

.jr-grid {
  display: grid;
  grid-template-columns: 7rem repeat(var(--slots), minmax(5rem, 1fr)) 3.25rem;
  grid-template-rows: 2.5rem repeat(3, auto);
}

.jr-zone {
  grid-row: 1 / -1;
  display: flex;
  justify-content: center;
  border-left: 1px dashed var(--border-strong);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}
.jr-zone.is-busy {
  background: color-mix(in srgb, var(--projects) 5%, transparent);
}
.jr-zone--now {
  grid-column: -2 / -1;
  background: color-mix(in srgb, var(--notes) 7%, transparent);
}

.jr-year {
  padding-top: 0.35rem;
  font-size: 1rem;
  font-weight: 700;
  color: var(--ink);
}

.jr-lane {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: subgrid;
  position: relative;
  padding: var(--space-3) 0 var(--space-2);
}

.jr-lane-title {
  grid-column: 1;
  position: sticky;
  left: 0;
  z-index: 2;
  margin: 0;
  padding-top: 0.2rem;
  background: var(--surface);
  color: var(--lane-text);
  font-size: 1.02rem;
  font-weight: 700;
  line-height: 1.2;
}
.jr-lane-title small {
  display: block;
  margin-top: 0.15rem;
  color: var(--ink-3);
  font-size: 0.75rem;
  font-weight: 600;
}

.jr-stops {
  grid-column: 2 / -1;
  display: grid;
  grid-template-columns: subgrid;
  position: relative;
  margin: 0;
  padding: 0;
  list-style: none;
}

/* The rail, ending in a terminus inside the Now column */
.jr-stops::before {
  content: '';
  position: absolute;
  left: 0;
  right: 1.6rem;
  top: 15px;
  height: 5px;
  border-radius: 3px;
  background: var(--lane);
  transform-origin: left center;
}
.rm-notes .jr-stops::before {
  height: 4px;
  top: 15.5px;
  background: repeating-linear-gradient(to right, var(--lane) 0 10px, transparent 10px 16px);
}
.jr-stops::after {
  content: '';
  position: absolute;
  right: calc(1.6rem - 7px);
  top: 10.5px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--surface);
  border: 3px solid var(--lane);
  box-sizing: border-box;
}

.jr-stop {
  position: relative;
  z-index: 1;
  min-width: 0;
  grid-row: 1;
}

.jr-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.2rem;
  padding: 0 0.25rem 0.25rem;
  border-radius: var(--radius-sm);
  color: var(--ink);
  text-align: center;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.jr-mark-wrap {
  display: grid;
  place-items: center;
  height: 35px;
}

.jr-mark {
  display: block;
  box-sizing: border-box;
  background: var(--surface);
  border: 3px solid var(--lane);
  transition: background 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
}
.jr-mark--dot { width: 18px; height: 18px; border-radius: 50%; }
.jr-mark--dot.is-big { width: 22px; height: 22px; border-width: 4px; }
.jr-mark--square { width: 18px; height: 18px; border-radius: 4px; }
.jr-mark--pill {
  padding: 0.18rem 0.6rem;
  border-width: 2px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--lane) 12%, var(--surface));
  color: var(--lane-text);
  font-size: 0.8rem;
  font-weight: 800;
  white-space: nowrap;
}

.jr-code {
  padding: 0 0.3rem;
  border-radius: 3px;
  background: color-mix(in srgb, var(--lane) 11%, var(--surface));
  color: var(--lane-text);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.jr-label {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  max-width: 100%;
  font-size: 0.8rem;
  font-weight: 600;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

/* Hover / focus: active stop fills, related stops on other lines glow, the rest soften */
.jr-link.is-active .jr-mark,
.jr-link:hover .jr-mark {
  background: var(--lane);
  box-shadow: 0 0 0 4px var(--glow);
}
.jr-link.is-active .jr-mark--pill,
.jr-link:hover .jr-mark--pill {
  color: #FFFFFF;
  background: var(--lane-text);
  border-color: var(--lane-text);
}
.jr-link.is-active .jr-label {
  text-decoration: underline;
  text-underline-offset: 2px;
}
.jr-link.is-related .jr-mark {
  box-shadow: 0 0 0 4px var(--glow), 0 0 12px var(--glow);
  transform: scale(1.15);
}
.jr-desktop.has-focus .jr-link:not(.is-active):not(.is-related) {
  opacity: 0.45;
}

/* Popover */
.jr-pop {
  position: absolute;
  z-index: 30;
  width: max-content;
  max-width: 260px;
  padding: 0.6rem 0.8rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface);
  box-shadow: 0 10px 30px rgba(31, 42, 51, 0.14);
