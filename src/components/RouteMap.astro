  display: grid;
  grid-template-columns: 1.5rem 1fr;
  align-items: baseline;
  min-height: 40px;
  padding: 0.45rem 0.5rem;
  color: var(--ink);
  text-decoration: none;
  border-radius: 6px;
  transition: all 0.15s ease;
}

.rm-list a:hover {
  background: var(--surface-2);
}

.rm-list a::before {
  content: '';
  grid-column: 1;
  grid-row: 1 / span 2;
  box-sizing: border-box;
  width: 10px;
  height: 10px;
  border: 2px solid var(--lane);
  border-radius: 50%;
  background: #FFFFFF;
  transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
}

.rm-learning a::before {
  border-radius: 3px;
}

.rm-list a[data-key^='cluster/']::before {
  width: 18px;
  border-radius: 999px;
}

.rm-list a:hover::before {
  transform: scale(1.2);
  background: var(--lane);
}

.rm-list b {
  grid-column: 2;
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--ink);
}

.rm-list a:hover b {
  color: var(--ink);
  text-decoration: underline;
}

.rm-list small {
  grid-column: 2;
  color: var(--ink-3);
  font-size: 0.825rem;
  margin-top: 0.15rem;
}

/* ---- SKILL FILTER LIGHT UP & DIMMING ---- */
.rm-station[data-dim] {
  opacity: 0.15 !important;
  transition: opacity 0.25s ease;
}

.rm-label[data-dim] {
  opacity: 0.1 !important;
  transition: opacity 0.25s ease;
}

.rm-connectors.has-skill-active {
  opacity: 0.18;
  transition: opacity 0.25s ease;
}

/* Light up matching station circles on the route map */
.rm-station.is-skill-match {
  opacity: 1 !important;
  z-index: 10;
}

.rm-station.is-skill-match circle {
  fill: #FFFFFF !important;
  stroke: var(--lane) !important;
  stroke-width: 4.5px !important;
  filter: drop-shadow(0 0 6px var(--lane));
}

.rm-station[data-shape='square'].is-skill-match rect {
  fill: #FFFFFF !important;
  stroke: var(--lane) !important;
  stroke-width: 4px !important;
  filter: drop-shadow(0 0 6px var(--lane));
}

.rm-station[data-shape='pill'] :is(rect) {
  fill: #FFFFFF;
  stroke: var(--lane);
  stroke-width: 2.5;
  transition: stroke 0.15s ease, fill 0.15s ease, stroke-width 0.15s ease;
}

.rm-station[data-shape='pill'] .rm-pill-label {
  font-size: 11.5px !important;
  font-weight: 800 !important;
  fill: #0F172A;
  pointer-events: none;
  transition: fill 0.15s ease;
}

.rm-station[data-shape='pill']:hover :is(rect),
.rm-station[data-shape='pill'].is-active :is(rect),
.rm-station[data-shape='pill'].is-skill-match :is(rect) {
  fill: var(--lane) !important;
  stroke: #FFFFFF !important;
  stroke-width: 3px !important;
  filter: drop-shadow(0 0 8px var(--lane)) !important;
}

.rm-station[data-shape='pill']:hover .rm-pill-label,
.rm-station[data-shape='pill'].is-active .rm-pill-label,
.rm-station[data-shape='pill'].is-skill-match .rm-pill-label {
  fill: #FFFFFF !important;
}

.rm-station[data-shape='pill']:hover ~ .rm-marker,
.rm-station[data-shape='pill'].is-active ~ .rm-marker {
  opacity: 0 !important;
}

.rm-label.is-skill-match {
  fill: #0F172A !important;
  font-weight: 800 !important;
  opacity: 1 !important;
}

/* Light up matching items in list down view */
.rm-list li[data-dim] {
  opacity: 0.25;
  transition: opacity 0.25s ease;
}

.rm-list li.is-skill-match a::before {
  transform: scale(1.3);
  background: var(--lane);
  box-shadow: 0 0 8px var(--lane);
}

.rm-list li.is-skill-match b {
  color: var(--ink);
  font-weight: 700;
  text-decoration: underline;
}

@media (max-width: 899px) {
  .rm-svg text { display: none; }
  .rm-lists { grid-template-columns: 1fr; gap: 2rem; }
}
@media (max-width: 899px), (pointer: coarse) {
  .rm-station a { pointer-events: none; }
}

@media (prefers-reduced-motion: no-preference) {
  .rm-wipe { stroke-dasharray: 1; animation: rm-wipe 1.1s cubic-bezier(0.3, 0, 0.2, 1) 0.15s backwards; }
  .rm-station { animation: rm-pop 0.28s ease-out var(--d, 0ms) backwards; }
  .rm-label { animation: rm-fade 0.28s ease-out var(--d, 0ms) backwards; }
  .rm-connectors { animation: rm-fade 0.35s ease-out 1.4s backwards; }
  .rm-now { animation: rm-fade 0.35s ease-out 1.3s backwards; }
  .rm-loop { stroke-dasharray: 1; animation: rm-wipe 0.5s ease-out 1.45s backwards; }
  .rm-marker.is-moving { transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @keyframes rm-wipe { from { stroke-dashoffset: 1; } }
  @keyframes rm-pop { from { opacity: 0; } }
  @keyframes rm-fade { from { opacity: 0; } }
}
</style>

<script>
function initRouteMap() {
  const root = document.querySelector<HTMLElement>('[data-route-map]');

  if (root && root.dataset.initialized !== 'true') {
    root.dataset.initialized = 'true';

    const caption = root.querySelector<HTMLElement>('[data-rm="caption"]')!;
    const status = root.querySelector<HTMLElement>('[data-rm="status"]')!;
    const chips = root.querySelector<HTMLElement>('[data-rm="chips"]')!;
    const marker = root.querySelector<SVGGElement>('.rm-marker')!;
    const stations = [...root.querySelectorAll<SVGGElement>('.rm-station')];
    const rows = [...root.querySelectorAll<HTMLElement>('.rm-list li')];
    const fallback = caption.textContent ?? '';

    let active: SVGGElement | undefined;
    let timer = 0;

    const show = (key: string) => {
      const s = stations.find((x) => x.dataset.key === key);
      if (!s) return;
      clearTimeout(timer);
      active?.classList.remove('is-active');
      active = s;
      s.classList.add('is-active');
      if (s.dataset.shape === 'pill') {
        marker.classList.remove('is-on', 'is-moving');
      } else {
        marker.style.setProperty('--mx', s.dataset.x!);
        marker.style.setProperty('--my', s.dataset.y!);
        const first = !marker.classList.contains('is-on');
        marker.classList.add('is-on');
        if (first) requestAnimationFrame(() => marker.classList.add('is-moving'));
      }
      caption.textContent = s.dataset.caption!;
    };

    const hide = () => {
      active?.classList.remove('is-active');
      active = undefined;
      marker.classList.remove('is-on', 'is-moving');
      caption.textContent = fallback;
    };

    const keyOf = (e: Event) => (e.target as Element).closest<HTMLElement | SVGElement>('[data-key]')?.dataset.key;

    const settle = () => {
      const f = document.activeElement?.closest<HTMLElement>('[data-key]');
      const el = f && root.contains(f) ? f : root.querySelector<HTMLElement | SVGElement>('[data-key]:hover');
      if (el?.dataset.key) show(el.dataset.key);
      else hide();
    };

    for (const [enter, leave] of [['pointerover', 'pointerout'], ['focusin', 'focusout']]) {
      root.addEventListener(enter, (e) => {
        const k = keyOf(e);
        if (k) show(k);
      });
      root.addEventListener(leave, () => {
        clearTimeout(timer);
        timer = window.setTimeout(settle, 80);
      });
    }

    // Tab switching between Route Map and List View
    const tabs = root.querySelectorAll<HTMLButtonElement>('.rm-tab-btn');
    const panelMap = root.querySelector<HTMLElement>('#panel-map');
    const panelList = root.querySelector<HTMLElement>('#panel-list');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const view = tab.dataset.view;
        tabs.forEach((t) => {
          const isActive = t === tab;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', String(isActive));
        });
        if (view === 'map') {
          if (panelMap) panelMap.hidden = false;
          if (panelList) panelList.hidden = true;
        } else {
          if (panelMap) panelMap.hidden = true;
          if (panelList) panelList.hidden = false;
        }
      });
    });

    // View all skills toggle button
    const toggleSkillsBtn = root.querySelector<HTMLButtonElement>('[data-action="toggle-skills"]');
    const kanbanGrid = root.querySelector<HTMLElement>('.kanban-grid');
    if (toggleSkillsBtn && kanbanGrid) {
      toggleSkillsBtn.addEventListener('click', () => {
        const isExpanded = kanbanGrid.classList.toggle('is-expanded');
        toggleSkillsBtn.setAttribute('aria-expanded', String(isExpanded));
        const span = toggleSkillsBtn.querySelector<HTMLElement>('.toggle-text');
        if (span) {
          span.textContent = isExpanded ? 'Show less' : 'View all skills';
        }
      });
    }

    // Skill filter (Multi-select)
    const selectedSkills = new Set<string>();

    chips.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button[data-skill]');
      if (!b) return;
      const sk = b.dataset.skill!;
      if (selectedSkills.has(sk)) {
        selectedSkills.delete(sk);
      } else {
        selectedSkills.add(sk);
      }

      for (const x of chips.querySelectorAll<HTMLButtonElement>('button[data-skill]')) {
        const isSelected = selectedSkills.has(x.dataset.skill!);
        x.setAttribute('aria-pressed', String(isSelected));
      }

      const isFiltering = selectedSkills.size > 0;
      const has = (el: HTMLElement | SVGElement) => {
        if (!isFiltering) return true;
        const entrySkills = (el.dataset.skills ?? '').split(' ').filter(Boolean);
        return entrySkills.some((s) => selectedSkills.has(s));
      };

      // Route Map Stations & Labels: light up matching stations, dim non-matching
      for (const s of stations) {
        const match = has(s);
        s.toggleAttribute('data-dim', isFiltering && !match);
        s.classList.toggle('is-skill-match', isFiltering && match);
      }
      for (const m of root.querySelectorAll<SVGElement>('.rm-label')) {
        const match = has(m);
        m.toggleAttribute('data-dim', isFiltering && !match);
        m.classList.toggle('is-skill-match', isFiltering && match);
      }
      root.querySelector('.rm-connectors')?.classList.toggle('has-skill-active', isFiltering);

      // List View Items: light up matching items, dim non-matching
      let shown = 0;
      for (const li of rows) {
        const match = has(li);
        li.toggleAttribute('data-dim', isFiltering && !match);
        li.classList.toggle('is-skill-match', isFiltering && match);
        if (match) shown++;
      }
      for (const list of root.querySelectorAll<HTMLElement>('.rm-list')) {
        const hasVisible = list.querySelector('li:not([data-dim])');
        list.classList.toggle('has-no-matches', isFiltering && !hasVisible);
      }

      status.textContent = isFiltering
        ? `Showing ${shown} entries matching ${selectedSkills.size} selected skill${selectedSkills.size > 1 ? 's' : ''}.`
        : 'Showing all entries.';
    });
  }
}

initRouteMap();
document.addEventListener('astro:page-load', initRouteMap);
</script>
