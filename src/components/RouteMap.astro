---
import { getCollection } from 'astro:content';
import { buildRouteMap, type MapEntry } from '../lib/route-map';

interface Props {
  now?: Date;
}

const { now = new Date() } = Astro.props;

const [projects, credentials, notes] = await Promise.all([
  getCollection('projects'),
  getCollection('credentials'),
  getCollection('notes', ({ data }) => !data.draft),
]);

const entries: MapEntry[] = [
  ...projects.map((e): MapEntry => ({
    key: `projects/${e.id}`,
    line: 'projects',
    title: e.data.title,
    date: e.data.date,
    href: `/projects/${e.id}/`,
    skills: e.data.skills,
    related: e.data.related,
    featured: e.data.featured,
  })),
  ...credentials.map((e): MapEntry => ({
    key: `credentials/${e.id}`,
    line: 'learning',
    title: e.data.title,
    date: e.data.date,
    href: `/learning/#${e.id}`,
    skills: e.data.skills,
    related: e.data.related,
    cluster: e.data.cluster,
    highlight: e.data.highlight,
  })),
  ...notes.map((e): MapEntry => ({
    key: `notes/${e.id}`,
    line: 'notes',
    title: e.data.title,
    date: e.data.date,
    href: `/notes/${e.id}/`,
    skills: e.data.skills,
    related: e.data.related,
  })),
];

const layout = buildRouteMap(entries, now);
const { width: W, height: H, nowX } = layout;

const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/\+/g, 'plus')
    .replace(/#/g, 'sharp')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const skillsOf = (skills: string[]) => skills.map(slug).join(' ');

// The 10 most-used skills become filter chips.
const count = new Map<string, number>();
for (const e of entries) {
  for (const s of e.skills) {
    count.set(s, (count.get(s) ?? 0) + 1);
  }
}
const chips = [...count]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 10)
  .map(([s]) => s);

const loop = `M${nowX - 27} 47C${nowX - 25} 32 ${nowX + 27} 30 ${nowX + 31} 49C${nowX + 34} 70 ${nowX - 28} 72 ${nowX - 33} 52`;
const labelY = (s: (typeof layout.stations)[number]) =>
  s.shape === 'pill' ? s.y + 4.5 : s.y + (s.labelBelow ? s.hh + 18 : -(s.hh + 9));
---

<section class="route-map" data-route-map aria-labelledby="rm-heading">
  <h2 id="rm-heading" class="sr-only">Everything I've built, learned and written</h2>

  <figure class="rm-figure">
    <svg class="rm-svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      <defs>
        <mask id="rm-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
          <path class="rm-wipe" d={`M0 ${H / 2}H${W}`} pathLength="1" fill="none" stroke="#fff" stroke-width={H} />
        </mask>
      </defs>
      <g class="rm-lines" mask="url(#rm-reveal)">
        {layout.lanes.map((l) => (
          <line class={`rm-line rm-${l.line}`} x1={layout.laneX1} y1={l.y} x2={nowX} y2={l.y} />
        ))}
      </g>
      <g class="rm-connectors">
        {layout.connectors.map((d) => (
          <path d={d} />
        ))}
      </g>
      <g class="rm-now">
        <line x1={nowX} y1="72" x2={nowX} y2="334" />
        <text x={nowX} y="56" text-anchor="middle">Now</text>
        <path class="rm-loop" pathLength="1" d={loop} />
      </g>
      <g class="rm-stations">
        {layout.stations.map((s) => (
          <g
            class={`rm-station rm-${s.line}`}
            data-key={s.key}
            data-x={s.x}
            data-y={s.y}
            data-skills={skillsOf(s.skills)}
            data-caption={s.caption}
            style={`--d:${s.delay}ms`}
          >
            <a href={s.href} tabindex="-1">
              {s.shape === 'circle' ? (
                <circle cx={s.x} cy={s.y} r={s.hw} />
              ) : (
                <rect
                  x={+(s.x - s.hw).toFixed(1)}
                  y={s.y - s.hh}
                  width={s.hw * 2}
                  height={s.hh * 2}
                  rx={s.shape === 'pill' ? s.hh : 3}
                />
              )}
            </a>
          </g>
        ))}
      </g>
      <g class="rm-labels">
        {layout.stations
          .filter((s) => s.label)
          .map((s) => (
            <text
              class="rm-label"
              x={s.x}
              y={labelY(s)}
              text-anchor={s.shape === 'pill' ? 'middle' : s.labelAnchor}
              data-skills={skillsOf(s.skills)}
              style={`--d:${s.delay}ms`}
            >
              {s.label}
            </text>
          ))}
        {layout.lanes.map((l) => (
          <>
            <text class="rm-title" x="16" y={l.y - 3}>
              {l.title}
            </text>
            <text class="rm-sub" x="16" y={l.y + 15}>
              {l.subtitle}
            </text>
          </>
        ))}
      </g>
      <g class="rm-marker">
        <circle r="17" />
      </g>
    </svg>
    <figcaption class="rm-caption" data-rm="caption">
      Everything I've built, learned and written, in the order it happened.
    </figcaption>
  </figure>

  <div class="rm-chips" role="group" aria-label="Show entries that use a skill" data-rm="chips" hidden>
    {chips.map((c) => (
      <button type="button" aria-pressed="false" data-skill={slug(c)}>
        {c}
      </button>
    ))}
  </div>
  <p class="sr-only" role="status" data-rm="status"></p>

  <div class="rm-lists">
    {layout.lanes.map((l) => (
      <section class={`rm-list rm-${l.line}`}>
        <h3>{l.title}</h3>
        <ul>
          {layout.stations
            .filter((s) => s.line === l.line)
            .reverse()
            .map((s) => (
              <li data-skills={skillsOf(s.skills)}>
                <a href={s.href} data-key={s.key}>
                  <b>{s.title}</b>
                  <small>{s.when}</small>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<style is:global>
.route-map {
  max-width: 1100px;
  margin-inline: auto;
  color: var(--ink);
  font-family: var(--font);
}
.rm-projects { --lane: var(--projects); --lane-text: var(--projects-text); }
.rm-learning { --lane: var(--learning); --lane-text: var(--learning-text); }
.rm-notes    { --lane: var(--notes);    --lane-text: var(--notes-text); }

/* ---- the map ---- */
.rm-figure { margin: 0; }
.rm-svg { display: block; width: 100%; height: auto; aspect-ratio: 1000 / 352; }
.rm-svg text { font: 700 13px var(--font); fill: var(--ink); pointer-events: none; }
.rm-svg .rm-title { font-size: 15px; }
.rm-svg .rm-sub { font-weight: 400; font-size: 12.5px; fill: var(--ink-2); }
.rm-line { stroke: var(--lane); stroke-width: 6; stroke-linecap: round; }
.rm-line.rm-notes { stroke-dasharray: 14 6; stroke-linecap: butt; }
.rm-connectors path { fill: none; stroke: var(--ink-2); stroke-width: 3; stroke-linejoin: round; }
.rm-now line { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 4 4; }
.rm-now text { font-size: 15px; }
.rm-loop { fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: round; }
.rm-station { transform-box: fill-box; transform-origin: center; }
.rm-station :is(circle, rect) { fill: var(--paper); stroke: var(--lane); stroke-width: 2.5; }
.rm-station.is-active :is(circle, rect) { stroke-width: 4; }
.rm-station[data-dim], .rm-label[data-dim] { opacity: 0.2; }
.rm-marker { fill: none; stroke: var(--ink); stroke-width: 2; opacity: 0; pointer-events: none;
  transform: translate(calc(var(--mx, 0) * 1px), calc(var(--my, 0) * 1px)); }
.rm-marker.is-on { opacity: 1; }
.rm-caption { min-height: 1.5em; margin: 0.5rem 0 0; color: var(--ink-2); }

/* ---- skill chips ---- */
.rm-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
.rm-chips button { min-height: 44px; padding: 0 1rem; border: 2px solid var(--ink); border-radius: 999px;
  background: transparent; color: var(--ink); font: inherit; cursor: pointer; }
.rm-chips button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }

/* ---- semantic navigation lists ---- */
.rm-lists { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; margin-top: 2rem; }
.rm-list h3 { margin: 0 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 3px solid var(--lane);
  color: var(--lane-text); font-size: 1.0625rem; }
.rm-list ul { margin: 0; padding: 0; list-style: none; }
.rm-list a { display: grid; grid-template-columns: 1.5rem 1fr; align-items: baseline; min-height: 44px;
  padding: 0.5rem 0; color: var(--ink); text-decoration: none; }
.rm-list a::before { content: ''; grid-column: 1; grid-row: 1 / span 2; box-sizing: border-box; width: 12px; height: 12px;
  border: 2.5px solid var(--lane); border-radius: 50%; background: var(--paper); }
.rm-learning a::before { border-radius: 3px; }
.rm-list a[data-key^='cluster/']::before { width: 20px; border-radius: 999px; }
.rm-list b { grid-column: 2; font-weight: 700; }
.rm-list small { grid-column: 2; color: var(--ink-2); font-size: 0.9375rem; }
.rm-list a:hover b { text-decoration: underline; }
.rm-list a:focus-visible, .rm-chips button:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

/* ---- small screens: map becomes a banner, lists do the work ---- */
@media (max-width: 899px) {
  .rm-svg text { display: none; }
  .rm-lists { grid-template-columns: 1fr; gap: 2rem; }
}
@media (max-width: 899px), (pointer: coarse) {
  .rm-station a { pointer-events: none; }
}

/* ---- motion: one intro, then only what the visitor triggers ---- */
@media (prefers-reduced-motion: no-preference) {
  .rm-wipe { stroke-dasharray: 1; animation: rm-wipe 1.1s cubic-bezier(0.3, 0, 0.2, 1) 0.15s backwards; }
  .rm-station { animation: rm-pop 0.28s ease-out var(--d, 0ms) backwards; transition: transform 0.12s ease-out; }
  .rm-station.is-active { transform: scale(1.25); }
  .rm-label { animation: rm-fade 0.28s ease-out var(--d, 0ms) backwards; }
  .rm-connectors { animation: rm-fade 0.35s ease-out 1.4s backwards; }
  .rm-now { animation: rm-fade 0.35s ease-out 1.3s backwards; }
  .rm-loop { stroke-dasharray: 1; animation: rm-wipe 0.5s ease-out 1.45s backwards; }
  .rm-marker.is-moving { transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @keyframes rm-wipe { from { stroke-dashoffset: 1; } }
  @keyframes rm-pop { from { opacity: 0; transform: scale(0.6); } }
  @keyframes rm-fade { from { opacity: 0; } }
}
</style>

<script>
function initRouteMap() {
  const root = document.querySelector<HTMLElement>('[data-route-map]');

  if (root && root.dataset.initialized !== 'true') {
    root.dataset.initialized = 'true';

    const caption = root.querySelector<HTMLElement>('[data-rm="caption"]')!;
    const status = root.querySelector<HTMLElement>('[data-rm="status"]')!;
    const chips = root.querySelector<HTMLElement>('[data-rm="chips"]')!;
    const marker = root.querySelector<SVGGElement>('.rm-marker')!;
    const stations = [...root.querySelectorAll<SVGGElement>('.rm-station')];
    const marks = [...root.querySelectorAll<SVGElement>('.rm-station, .rm-label')];
    const rows = [...root.querySelectorAll<HTMLElement>('.rm-list li')];
    const fallback = caption.textContent ?? '';

    let active: SVGGElement | undefined;
    let timer = 0;

    const show = (key: string) => {
      const s = stations.find((x) => x.dataset.key === key);
      if (!s) return;
      clearTimeout(timer);
      active?.classList.remove('is-active');
      active = s;
      s.classList.add('is-active');
      marker.style.setProperty('--mx', s.dataset.x!);
      marker.style.setProperty('--my', s.dataset.y!);
      const first = !marker.classList.contains('is-on');
      marker.classList.add('is-on');
      if (first) requestAnimationFrame(() => marker.classList.add('is-moving'));
      caption.textContent = s.dataset.caption!;
    };

    const hide = () => {
      active?.classList.remove('is-active');
      active = undefined;
      marker.classList.remove('is-on', 'is-moving');
      caption.textContent = fallback;
    };

    const keyOf = (e: Event) => (e.target as Element).closest<HTMLElement | SVGElement>('[data-key]')?.dataset.key;

    const settle = () => {
      const f = document.activeElement?.closest<HTMLElement>('[data-key]');
      const el = f && root.contains(f) ? f : root.querySelector<HTMLElement | SVGElement>('[data-key]:hover');
      if (el?.dataset.key) show(el.dataset.key);
      else hide();
    };

    for (const [enter, leave] of [['pointerover', 'pointerout'], ['focusin', 'focusout']]) {
      root.addEventListener(enter, (e) => {
        const k = keyOf(e);
        if (k) show(k);
      });
      root.addEventListener(leave, () => {
        clearTimeout(timer);
        timer = window.setTimeout(settle, 80);
      });
    }

    // Skill filter
    let skill = '';
    chips.hidden = false;
    chips.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button[data-skill]');
      if (!b) return;
      skill = skill === b.dataset.skill ? '' : b.dataset.skill!;
      for (const x of chips.querySelectorAll('button')) {
        x.setAttribute('aria-pressed', String(!!skill && x === b));
      }
      const has = (el: HTMLElement | SVGElement) => !skill || (el.dataset.skills ?? '').split(' ').includes(skill);
      for (const m of marks) {
        m.toggleAttribute('data-dim', !has(m));
      }
      let shown = 0;
      for (const li of rows) {
        li.hidden = !has(li);
        if (!li.hidden) shown++;
      }
      for (const list of root.querySelectorAll<HTMLElement>('.rm-list')) {
        list.hidden = !list.querySelector('li:not([hidden])');
      }
      status.textContent = skill ? `Showing ${shown} entries that use ${b.textContent}.` : 'Showing all entries.';
    });
  }
}

// Support both standard loads and Astro View Transitions (astro:page-load)
initRouteMap();
document.addEventListener('astro:page-load', initRouteMap);
</script>
