                <li class="jr-stop" style={`grid-column: ${s.col}; --d: ${150 + s.col * 70}ms`}>
                  <a
                    class="jr-link"
                    href={s.href}
                    data-key={s.key}
                    data-skills={skillsOf(s.skills)}
                    data-related={s.related.join(' ')}
                    data-title={s.title}
                    data-meta={`${s.code} · ${laneTitle[s.line]} · ${s.when}`}
