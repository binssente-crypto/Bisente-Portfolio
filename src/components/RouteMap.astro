---
import { getCollection } from 'astro:content';
import { buildRouteMap, type MapEntry } from '../lib/route-map';

interface Props {
  now?: Date;
}

const { now = new Date() } = Astro.props;

const [projects, credentials, notes] = await Promise.all([
  getCollection('projects'),
  getCollection('credentials'),
  getCollection('notes', ({ data }) => !data.draft),
]);

const entries: MapEntry[] = [
  ...projects.map((e): MapEntry => ({
    key: `projects/${e.id}`,
    line: 'projects',
    title: e.data.title,
    date: e.data.date,
    href: `/projects/${e.id}/`,
    skills: e.data.skills,
    related: e.data.related,
    featured: e.data.featured,
  })),
  ...credentials.map((e): MapEntry => ({
    key: `credentials/${e.id}`,
    line: 'learning',
    title: e.data.title,
    date: e.data.date,
    href: `/learning/#${e.id}`,
    skills: e.data.skills,
    related: e.data.related,
    cluster: e.data.cluster,
    highlight: e.data.highlight,
  })),
  ...notes.map((e): MapEntry => ({
    key: `notes/${e.id}`,
    line: 'notes',
    title: e.data.title,
    date: e.data.date,
    href: `/notes/${e.id}/`,
    skills: e.data.skills,
    related: e.data.related,
  })),
];

const layout = buildRouteMap(entries, now);
const { width: W, height: H, nowX } = layout;

const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/\+/g, 'plus')
    .replace(/#/g, 'sharp')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const skillsOf = (skills: string[]) => skills.map(slug).join(' ');

// Comprehensive Kanban-style skills grouped by category with SVG icons
const skillCategories = [
  {
    name: 'Languages & Core',
    color: '#00E5FF',
    skills: [
      { name: 'JavaScript', slug: 'javascript', icon: 'js', common: true },
      { name: 'TypeScript', slug: 'typescript', icon: 'ts', common: true },
      { name: 'Python', slug: 'python', icon: 'python', common: true },
      { name: 'PHP', slug: 'php', icon: 'php', common: true },
      { name: 'SQL', slug: 'sql', icon: 'db', common: true },
      { name: 'HTML5', slug: 'html5', icon: 'html', common: false },
      { name: 'CSS3', slug: 'css3', icon: 'css', common: false },
      { name: 'Bash', slug: 'bash', icon: 'terminal', common: false },
    ],
  },
  {
    name: 'Frontend & UI',
    color: '#A855F7',
    skills: [
      { name: 'React', slug: 'react', icon: 'react', common: true },
      { name: 'Next.js', slug: 'next-js', icon: 'next', common: true },
      { name: 'Vue.js', slug: 'vue-js', icon: 'vue', common: true },
      { name: 'TailwindCSS', slug: 'tailwindcss', icon: 'tailwind', common: true },
      { name: 'Pinia', slug: 'pinia', icon: 'pinia', common: false },
      { name: 'Bootstrap', slug: 'bootstrap', icon: 'bootstrap', common: false },
      { name: 'SVG / Canvas', slug: 'svg', icon: 'vector', common: false },
    ],
  },
  {
    name: 'Backend & APIs',
    color: '#FF6B00',
    skills: [
      { name: 'Node.js', slug: 'node-js', icon: 'node', common: true },
      { name: 'Express', slug: 'express', icon: 'server', common: true },
      { name: 'REST APIs', slug: 'apis', icon: 'api', common: true },
      { name: 'Docker', slug: 'docker', icon: 'docker', common: true },
      { name: 'Laravel', slug: 'laravel', icon: 'laravel', common: false },
      { name: 'Django', slug: 'django', icon: 'django', common: false },
      { name: 'FastAPI', slug: 'fastapi', icon: 'fastapi', common: false },
      { name: 'WebSockets', slug: 'websockets', icon: 'socket', common: false },
    ],
  },
  {
    name: 'Cyber & Defense',
    color: '#00FF9D',
    skills: [
      { name: 'Cybersecurity', slug: 'cybersecurity', icon: 'shield', common: true },
      { name: 'SOC Operations', slug: 'soc-operations', icon: 'radar', common: true },
      { name: 'Incident Response', slug: 'incident-response', icon: 'alert', common: true },
      { name: 'Network Defense', slug: 'network-defense', icon: 'firewall', common: true },
      { name: 'Threat Intel', slug: 'threat-intelligence', icon: 'intel', common: false },
      { name: 'Packet Analysis', slug: 'packet-analysis', icon: 'packet', common: false },
      { name: 'Cisco IOS', slug: 'cisco-ios', icon: 'cisco', common: false },
      { name: 'Linux Security', slug: 'linux-security', icon: 'linux', common: false },
    ],
  },
  {
    name: 'Databases & Cloud',
    color: '#38BDF8',
    skills: [
      { name: 'PostgreSQL', slug: 'postgresql', icon: 'postgres', common: true },
      { name: 'MySQL', slug: 'mysql', icon: 'mysql', common: true },
      { name: 'SQLite', slug: 'sqlite', icon: 'db', common: true },
      { name: 'Redis', slug: 'redis', icon: 'redis', common: true },
      { name: 'Prisma ORM', slug: 'prisma', icon: 'prisma', common: false },
      { name: 'Supabase', slug: 'supabase', icon: 'supabase', common: false },
      { name: 'Cloudflare', slug: 'cloudflare', icon: 'cloud', common: false },
    ],
  },
];

const loop = `M${nowX - 27} 47C${nowX - 25} 32 ${nowX + 27} 30 ${nowX + 31} 49C${nowX + 34} 70 ${nowX - 28} 72 ${nowX - 33} 52`;
---

<section class="route-map" data-route-map aria-labelledby="rm-heading">
  <!-- SKILLS SECTION (Kanban Style without outer container) -->
  <div class="skills-section">
    <div class="skills-header-row">
      <h3 class="skills-title">Skills</h3>
      <button
        type="button"
        class="view-all-skills-btn"
        data-action="toggle-skills"
        aria-expanded="false"
      >
        <span class="toggle-text">View all skills</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>

    <div class="kanban-grid" data-rm="chips" role="group" aria-label="Show entries that use a skill">
      {skillCategories.map((col) => (
        <div class="kanban-column" style={`--col-accent: ${col.color};`}>
          <div class="kanban-column-header">
            <span class="column-dot"></span>
            <span class="column-name">{col.name}</span>
            <span class="column-count">{col.skills.length}</span>
          </div>
          <div class="column-pills">
            {col.skills.map((sk) => (
              <button
                type="button"
                aria-pressed="false"
                data-skill={sk.slug}
                class={`skill-pill-btn ${sk.common ? 'is-common-skill' : 'is-extra-skill'}`}
                title={`Filter timeline by ${sk.name}`}
              >
                <!-- Compact inline SVG icons -->
                {sk.icon === 'js' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pill-icon js-icon">
                    <rect width="24" height="24" rx="3" fill="#F7DF1E"/>
                    <path d="M12.5 15.5c0 2.2 1.3 3.3 3.3 3.3 1.5 0 2.6-.7 3.2-1.7l-1.6-1c-.4.6-.9.9-1.6.9-.9 0-1.4-.5-1.4-1.5V9.5h-1.9v6zm-6.2.7c.6.9 1.4 1.4 2.5 1.4 1.3 0 2.1-.7 2.1-1.7 0-1.2-.8-1.6-2.2-2.2-1.6-.7-2.7-1.5-2.7-3.1 0-1.8 1.4-3.1 3.5-3.1 1.6 0 2.7.6 3.4 1.8l-1.6 1c-.4-.7-.9-1-1.8-1-1 0-1.6.6-1.6 1.3 0 .9.6 1.3 1.8 1.8 1.9.8 3.1 1.6 3.1 3.4 0 2.1-1.6 3.4-4 3.4-2.1 0-3.4-1-4.1-2.4l1.5-1.1z" fill="#000"/>
                  </svg>
                )}
                {sk.icon === 'ts' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pill-icon ts-icon">
                    <rect width="24" height="24" rx="3" fill="#3178C6"/>
                    <path d="M14.5 10.5h-3v8h-2v-8h-3v-2h8v2zm7 3.3c-.3-.2-.8-.4-1.3-.4-.7 0-1.1.3-1.1.7 0 .5.5.7 1.4 1 1.4.5 2.2 1.2 2.2 2.4 0 1.6-1.3 2.6-3.2 2.6-1.3 0-2.3-.4-3-1.1l1.1-1.3c.6.5 1.2.8 1.9.8.8 0 1.3-.4 1.3-.9 0-.4-.4-.7-1.3-.9-1.5-.5-2.3-1.1-2.3-2.4 0-1.5 1.2-2.5 3-2.5 1.1 0 2 .3 2.6.7l-1.3 1.3z" fill="#FFF"/>
                  </svg>
                )}
                {sk.icon === 'python' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pill-icon">
                    <path d="M11.9 2c-5.2 0-4.9 2.3-4.9 2.3l.1 2.3h4.9v.7H5.2S2 7 2 12.2c0 5.2 2.8 5 2.8 5l1.7-.1v-2.3s-.1-2.8 2.8-2.8h4.8s2.7 0 2.7-2.6V4.7S17.1 2 11.9 2zm-1.4 1.5c.5 0 .9.4.9.9s-.4.9-.9.9-.9-.4-.9-.9.4-.9.9-.9z" fill="#387EB8"/>
                    <path d="M12.1 22c5.2 0 4.9-2.3 4.9-2.3l-.1-2.3h-4.9v-.7h6.8s3.2.3 3.2-4.9c0-5.2-2.8-5-2.8-5l-1.7.1v2.3s.1 2.8-2.8 2.8H9.9s-2.7 0-2.7 2.6v4.7s-.3 2.7 4.9 2.7zm1.4-1.5c-.5 0-.9-.4-.9-.9s.4-.9.9-.9.9.4.9.9-.4.9-.9.9z" fill="#FFE052"/>
                  </svg>
                )}
                {sk.icon === 'php' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pill-icon">
                    <path d="M7 6c-2.8 0-5 2.2-5 5s2.2 5 5 5c1.4 0 2.7-.6 3.6-1.5l1.4 1.5h2l2-10H14l-.6 3h-2.1C10.4 7.2 8.8 6 7 6zm0 2.5c1.4 0 2.5 1.1 2.5 2.5s-1.1 2.5-2.5 2.5S4.5 12.4 4.5 11 5.6 8.5 7 8.5zm11.5-2.5c-2.8 0-5 2.2-5 5s2.2 5 5 5 5-2.2 5-5-2.2-5-5-5zm0 2.5c1.4 0 2.5 1.1 2.5 2.5s-1.1 2.5-2.5 2.5-2.5-1.1-2.5-2.5 1.1-2.5 2.5-2.5z" fill="#777BB4"/>
                  </svg>
                )}
                {sk.icon === 'html' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#E34F26" class="pill-icon">
                    <path d="M4 2l1.6 18.2L12 22l6.4-1.8L20 2H4zm13.3 5.4H8.4l.2 2.3h8.3l-.6 6.3-4.3 1.2-4.3-1.2-.3-3.2h2l.1 1.6 2.5.7 2.5-.7.3-2.8H6.5l-.7-6.5h11.7l-.2 2.3z"/>
                  </svg>
                )}
                {sk.icon === 'css' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#1572B6" class="pill-icon">
                    <path d="M4 2l1.6 18.2L12 22l6.4-1.8L20 2H4zm13.3 5.4H8.4l.2 2.3h8.3l-.6 6.3-4.3 1.2-4.3-1.2-.3-3.2h2l.1 1.6 2.5.7 2.5-.7.3-2.8H6.5l-.7-6.5h11.7l-.2 2.3z"/>
                  </svg>
                )}
                {sk.icon === 'terminal' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#4EAA25" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="pill-icon">
                    <polyline points="4 17 10 11 4 5"/>
                    <line x1="12" y1="19" x2="20" y2="19"/>
                  </svg>
                )}
                {sk.icon === 'react' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#00D8FF" stroke-width="2" class="pill-icon">
                    <circle cx="12" cy="12" r="2" fill="#00D8FF"/>
                    <ellipse cx="12" cy="12" rx="10" ry="4.5"/>
                    <ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(60 12 12)"/>
                    <ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(120 12 12)"/>
                  </svg>
                )}
                {sk.icon === 'next' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pill-icon">
                    <circle cx="12" cy="12" r="11" fill="#000" stroke="#FFF" stroke-width="1.5"/>
                    <path d="M15.5 8.5v7l-6-7v7" stroke="#FFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                )}
                {sk.icon === 'vue' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pill-icon">
                    <polygon points="12 19 2 2 6.5 2 12 11.5 17.5 2 22 2" fill="#41B883"/>
                    <polygon points="12 14.5 6.5 5 9.5 5 12 9.5 14.5 5 17.5 5" fill="#35495E"/>
                  </svg>
                )}
                {sk.icon === 'pinia' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="pill-icon">
                    <path d="M12 2c-.5 2-2 3-3 4 2 0 3.5 1 4 2 .5-1 2-2 4-2-1-1-2.5-2-3-4z" fill="#41B883"/>
                    <ellipse cx="12" cy="15" rx="6" ry="7.5" fill="#FFE566" stroke="#F59E0B" stroke-width="1.2"/>
                    <circle cx="10" cy="14" r="0.9" fill="#451A03"/>
                    <circle cx="14" cy="14" r="0.9" fill="#451A03"/>
                  </svg>
                )}
                {sk.icon === 'tailwind' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#38BDF8" class="pill-icon">
                    <path d="M12 6c-3 0-4.5 1.5-4.5 4.5 1-1.5 2.5-2 4.5-1.5 1.8.5 2.8 2 4.5 2 3 0 4.5-1.5 4.5-4.5-1 1.5-2.5 2-4.5 1.5-1.8-.5-2.8-2-4.5-2zm-6 6c-3 0-4.5 1.5-4.5 4.5 1-1.5 2.5-2 4.5-1.5 1.8.5 2.8 2 4.5 2 3 0 4.5-1.5 4.5-4.5-1 1.5-2.5 2-4.5 1.5-1.8-.5-2.8-2-4.5-2z"/>
                  </svg>
                )}
                {sk.icon === 'bootstrap' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="pill-icon">
                    <rect width="24" height="24" rx="4.5" fill="#7952B3"/>
                    <path d="M8 6h4.5c1.6 0 2.7.8 2.7 2.1 0 1-.6 1.7-1.5 2v.1c1.2.3 2 1.2 2 2.4 0 1.5-1.3 2.4-3.1 2.4H8V6zm2.2 3.6h2c.7 0 1.1-.3 1.1-.9s-.4-.9-1.1-.9h-2v1.8zm0 3.6h2.2c.8 0 1.2-.4 1.2-1s-.4-1-1.2-1h-2.2v2z" fill="#FFF"/>
                  </svg>
