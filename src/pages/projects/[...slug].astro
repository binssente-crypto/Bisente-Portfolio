---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const year = new Date(project.data.date).getUTCFullYear();
---

<Base title={`${project.data.title} — Projects`}>
  <article class="project-page">
    <nav class="back-nav" aria-label="Navigation">
      <a href="/" class="back-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Route Map
      </a>
    </nav>

    <header class="project-header">
      {project.data.logo && (
        <div class="project-logo-wrap">
          <img src={project.data.logo} alt={`${project.data.title} logo`} class="project-logo" />
        </div>
      )}

      <div class="meta-row">
        <span class="year-badge">{year}</span>
        {project.data.client && <span class="client-badge">{project.data.client}</span>}
        {project.data.role && <span class="role-badge">{project.data.role}</span>}
      </div>

      <h1>{project.data.title}</h1>

      <p class="outcome-callout">{project.data.outcome}</p>

      {(project.data.links?.live || project.data.links?.repo || project.data.links?.demo) && (
        <div class="live-action">
          {project.data.links?.live && (
            <a href={project.data.links.live} target="_blank" rel="noopener noreferrer" class="btn-live">
              View Live Site
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          )}
          {project.data.links?.repo && (
            <a href={project.data.links.repo} target="_blank" rel="noopener noreferrer" class="btn-live btn-repo">
              View Repository
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </a>
          )}
          {project.data.links?.demo && (
            <a href={project.data.links.demo} target="_blank" rel="noopener noreferrer" class="btn-live btn-demo">
              View Demo
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </a>
          )}
        </div>
      )}

      <div class="skills-wrap" aria-label="Technologies used">
        {project.data.skills.map((skill) => (
          <span class="skill-tag">{skill}</span>
        ))}
      </div>
    </header>

    <div class="project-content">
      <Content />
    </div>
  </article>

  <script>
    function setupCarousel() {
      const track = document.getElementById('gallery-track');
      const prevBtn = document.getElementById('prev-slide');
      const nextBtn = document.getElementById('next-slide');
      const countEl = document.getElementById('carousel-count');

      if (!track || !prevBtn || !nextBtn) return;

      const getCardWidth = () => {
        const card = track.querySelector('.carousel-card');
        return card ? (card as HTMLElement).offsetWidth + 20 : 380;
      };

      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
      });

      if (countEl) {
        const cards = track.querySelectorAll('.carousel-card');
        const total = cards.length;
        const updateStatus = () => {
          const cardWidth = getCardWidth();
          const activeIndex = Math.min(total, Math.max(1, Math.round(track.scrollLeft / cardWidth) + 1));
          countEl.textContent = `Photo ${activeIndex} of ${total} • Swipe or click arrows`;
        };
        track.addEventListener('scroll', updateStatus, { passive: true });
        updateStatus();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCarousel);
    } else {
      setupCarousel();
    }
  </script>
</Base>

<style>
.project-page {
  max-width: 820px;
  margin: 0 auto;
}

.back-nav {
  margin-bottom: 2rem;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--ink-2);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  transition: color 0.15s ease;
}

.back-link:hover {
  color: var(--notes);
  text-decoration: none;
}

.project-header {
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--rail);
}

.project-logo-wrap {
  margin-bottom: 1.5rem;
}

.project-logo {
  max-height: 80px;
  max-width: 220px;
  object-fit: contain;
  border-radius: 8px;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
  margin-bottom: 1rem;
}

.year-badge {
  background: var(--projects);
  color: #fff;
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-size: 0.85rem;
  font-weight: 700;
}

.client-badge {
  background: var(--surface-2);
  color: var(--ink);
  border: 1px solid var(--rail);
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-size: 0.85rem;
  font-weight: 600;
}

.role-badge {
  background: rgba(0, 229, 255, 0.12);
  color: var(--notes);
  border: 1px solid rgba(0, 229, 255, 0.35);
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-size: 0.85rem;
  font-weight: 700;
}

h1 {
  margin: 0.5rem 0 1rem;
  color: var(--ink);
  font-size: clamp(2rem, 4vw, 2.5rem);
}

.outcome-callout {
  font-size: 1.15rem;
  line-height: 1.6;
  color: var(--ink-2);
  font-weight: 500;
  margin-bottom: 1.5rem;
}

.live-action {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.btn-live {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(0, 229, 255, 0.15);
  color: var(--notes);
  border: 1px solid rgba(0, 229, 255, 0.4);
  padding: 0.55rem 1.15rem;
  border-radius: 999px;
  font-weight: 700;
  text-decoration: none;
  font-size: 0.95rem;
  transition: all 0.2s ease;
}

.btn-live:hover {
  background: rgba(0, 229, 255, 0.25);
  box-shadow: 0 0 15px rgba(0, 229, 255, 0.3);
  color: #FFF;
}

.btn-repo {
  background: var(--surface-2);
  color: var(--ink);
  border: 1px solid var(--rail);
}

.btn-repo:hover {
  background: #1F2C46;
  border-color: var(--notes);
  color: #FFF;
}

.btn-demo {
  background: var(--projects);
  color: #ffffff;
  border: 1px solid rgba(255, 107, 0, 0.5);
}

.btn-demo:hover {
  opacity: 0.92;
  box-shadow: 0 0 15px rgba(255, 107, 0, 0.4);
}

.skills-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1rem;
}

.skill-tag {
  background: var(--surface);
  border: 1px solid var(--rail);
  color: var(--ink);
  padding: 0.25rem 0.75rem;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 600;
}

.project-content {
  line-height: 1.75;
  color: var(--ink);
}

.project-content :global(h3) {
  font-size: 1.3rem;
  margin-top: 2rem;
  margin-bottom: 0.85rem;
  color: var(--ink);
  border-bottom: 1px solid var(--rail);
  padding-bottom: 0.4rem;
}

.project-content :global(ul) {
  padding-left: 1.25rem;
  margin-bottom: 1.5rem;
}

.project-content :global(li) {
  margin-bottom: 0.5rem;
  color: var(--ink-2);
}

.project-content :global(p) {
  color: var(--ink-2);
  margin-bottom: 1.25rem;
}

.project-content :global(strong) {
  color: var(--ink);
}

/* =====================================================================
   HORIZONTAL PHOTO CAROUSEL
   ===================================================================== */
.project-content :global(.carousel-wrapper) {
  margin: 2rem 0;
  background: var(--surface-card);
  border: 1px solid var(--rail);
  border-radius: 12px;
  padding: 1.25rem;
  backdrop-filter: blur(8px);
}

.project-content :global(.carousel-header-bar) {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
  padding: 0 0.25rem 0.75rem;
  border-bottom: 1px solid var(--rail);
}

.project-content :global(.carousel-status) {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--accent-gold);
}

.project-content :global(.status-indicator) {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent-gold);
  box-shadow: 0 0 8px var(--accent-gold);
}

.project-content :global(.carousel-arrows) {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.project-content :global(.arrow-btn) {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--surface-2);
  border: 1px solid var(--rail-light);
  color: var(--ink);
  cursor: pointer;
  transition: all 0.2s ease;
}

.project-content :global(.arrow-btn:hover) {
  background: rgba(0, 229, 255, 0.15);
  border-color: var(--notes);
  color: var(--notes);
  box-shadow: 0 0 12px rgba(0, 229, 255, 0.3);
}

.project-content :global(.carousel-track) {
  display: flex;
  gap: 1.25rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  padding: 0.25rem 0.25rem 0.75rem;
  scrollbar-width: thin;
}

.project-content :global(.carousel-card) {
  flex: 0 0 380px;
  width: 380px;
  scroll-snap-align: start;
  background: var(--surface);
  border: 1px solid var(--rail);
  border-radius: 10px;
  overflow: hidden;
  margin: 0;
  padding: 0.65rem;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.project-content :global(.carousel-card:hover) {
  transform: translateY(-2px);
  border-color: rgba(0, 229, 255, 0.4);
}

.project-content :global(.img-frame) {
  width: 100%;
  height: 250px; /* Exact uniform height for all images */
  border-radius: 6px;
  overflow: hidden;
  background: #080C14;
}

.project-content :global(.img-frame img) {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Exact uniform framing */
  object-position: center;
  display: block;
  transition: transform 0.3s ease;
}

.project-content :global(.carousel-card:hover .img-frame img) {
  transform: scale(1.03);
}

.project-content :global(.carousel-card figcaption) {
  padding: 0.65rem 0.35rem 0.25rem;
  font-size: 0.85rem;
  color: var(--ink-2);
  text-align: center;
  font-weight: 500;
  line-height: 1.35;
}

@media (max-width: 640px) {
  .project-content :global(.carousel-card) {
    flex: 0 0 85vw;
    width: 85vw;
  }
  .project-content :global(.img-frame) {
    height: 210px;
  }
}
</style>
