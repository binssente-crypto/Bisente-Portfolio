<style>
/* CSS RESET & ATS COMPLIANCE */
*, *::before, *::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
  background: #f1f5f9;
  color: #000000;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-size: 10.5pt;
  line-height: 1.4;
  -webkit-font-smoothing: antialiased;
}

/* SCREEN ACTION BAR */
.action-bar {
  background: #0f2233;
  color: #ffffff;
  padding: 0.75rem 1rem;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}

.action-container {
  max-width: 820px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.action-right {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.85rem;
  border-radius: 5px;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.15s ease;
}

.back-btn {
  background: transparent;
  color: #ffffff;
  border-color: rgba(255,255,255,0.25);
}
.back-btn:hover {
  background: rgba(255,255,255,0.1);
}

.text-btn {
  background: #ffffff;
  color: #0f2233;
}
.text-btn:hover {
  background: #e2e8f0;
}

.print-btn {
  background: #009e73;
  color: #ffffff;
}
.print-btn:hover {
  background: #00805d;
}

/* RESUME SHEET CONTAINER */
.resume-sheet {
  max-width: 820px;
  margin: 2rem auto;
  background: #ffffff;
  padding: 2.75rem 3rem;
  box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  border: 1px solid #e2e8f0;
}

/* HEADER */
.resume-header {
  text-align: center;
  border-bottom: 2px solid #000000;
  padding-bottom: 0.75rem;
  margin-bottom: 1.15rem;
}

.candidate-name {
  margin: 0 0 0.2rem;
  font-size: 20pt;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: #000000;
}

.candidate-title {
  margin: 0 0 0.4rem;
  font-size: 11.5pt;
  font-weight: 700;
  color: #111111;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.candidate-contact,
.candidate-links {
  margin: 0.15rem 0;
  font-size: 8.5pt;
  color: #000000;
  line-height: 1.35;
}

.sep {
  display: inline-block;
  margin: 0 0.45rem;
  color: #000000;
  user-select: none;
}

.resume-sheet a,
.resume-sheet a:link,
.resume-sheet a:visited,
.resume-sheet a:hover,
.resume-sheet a:active {
  color: #000000 !important;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 2px;
}

/* SECTIONS */
.resume-section {
  margin-bottom: 1.15rem;
}

.section-title {
  font-size: 11pt;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid #000000;
  padding-bottom: 0.15rem;
  margin: 0 0 0.5rem;
  color: #000000;
}

.summary-text {
  margin: 0;
  font-size: 10pt;
  text-align: justify;
  line-height: 1.45;
}

/* SKILLS LIST */
.skills-list,
.certs-list {
  margin: 0;
  padding-left: 1.15rem;
  font-size: 9.5pt;
  line-height: 1.45;
}

.skills-list li,
.certs-list li {
  margin-bottom: 0.25rem;
}

/* EXPERIENCE & PROJECT ITEMS */
.job-item,
.project-item,
.edu-item {
  margin-bottom: 0.85rem;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.item-role {
  margin: 0;
  font-size: 10.5pt;
  font-weight: 700;
  color: #000000;
}

.item-dates {
  font-size: 9.5pt;
  font-weight: 600;
  color: #222222;
  white-space: nowrap;
}

.item-sub {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 9.5pt;
  font-style: italic;
  margin-bottom: 0.3rem;
  color: #333333;
}

.item-bullets {
  margin: 0.2rem 0 0;
  padding-left: 1.15rem;
  font-size: 9.5pt;
  line-height: 1.4;
}

.item-bullets li {
  margin-bottom: 0.2rem;
}

/* PRINT MEDIA QUERY (BROWSER PRINT-TO-PDF) */
@media print {
  @page {
    margin: 0.35in 0.45in;
    size: letter;
  }

  body {
    background: #ffffff !important;
    color: #000000 !important;
    font-size: 8.5pt !important;
    line-height: 1.25 !important;
  }

  .action-bar {
    display: none !important;
  }

  .resume-sheet {
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }

  .candidate-name {
    font-size: 16pt !important;
  }

  .candidate-title {
    font-size: 9.5pt !important;
  }

  .resume-header {
    margin-bottom: 0.65rem !important;
    padding-bottom: 0.45rem !important;
  }

  .resume-section {
    margin-bottom: 0.65rem !important;
  }

  .section-title {
    font-size: 9pt !important;
    margin-top: 0.25rem !important;
    margin-bottom: 0.25rem !important;
    padding-bottom: 0.1rem !important;
  }

  .job-item,
  .project-item,
  .edu-item {
    page-break-inside: avoid;
    margin-bottom: 0.45rem !important;
  }

  .item-bullets {
    margin-top: 0.15rem !important;
  }

  .item-bullets li {
    margin-bottom: 0.15rem !important;
  }

  .skills-list li,
  .certs-list li {
    margin-bottom: 0.15rem !important;
  }

  a,
  a:link,
  a:visited,
  a:hover,
  a:active {
    color: #000000 !important;
    text-decoration: none !important;
  }
}
</style>
