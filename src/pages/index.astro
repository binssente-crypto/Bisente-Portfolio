---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import RouteMap from '../components/RouteMap.astro';

// "At a glance" numbers come straight from the content collections, so they stay current
const [projects, credentials, notes] = await Promise.all([
  getCollection('projects'),
  getCollection('credentials'),
  getCollection('notes', ({ data }) => !data.draft),
]);
const stats = [
  { value: projects.length, label: 'Projects shipped', accent: 'var(--projects-text)' },
  { value: credentials.length, label: 'Credentials', accent: 'var(--learning-text)' },
  { value: notes.length, label: 'Notes written', accent: 'var(--notes-text)' },
  { value: Math.min(...projects.map((p) => p.data.date.getUTCFullYear())), label: 'Building since', accent: 'var(--accent-gold)' },
];
---

<Base title="Mark Reizel Vincent C. Palma | Full-Stack Engineer & Software Developer">
  <main class="container">
    <header class="hero-section">
      <div class="hero-profile">
        <div class="portrait-wrapper">
          <img
            src="/images/profile.png"
            alt="Mark Reizel Vincent C. Palma in graduation toga"
            class="portrait-img"
            width="150"
            height="150"
          />
        </div>

        <div class="hero-details">
          <!-- Name and Contact Info Row -->
          <div class="name-contact-row">
            <h1 class="hero-name">Mark Reizel Vincent C. Palma</h1>
            <div class="contact-strip">
              <a href="mailto:binssente@gmail.com" class="contact-item" title="Send email">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <span>binssente@gmail.com</span>
              </a>
              <a href="tel:+639158057972" class="contact-item" title="Call phone number">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <span>+63 915 805 7972</span>
              </a>
            </div>
          </div>

          <p class="hero-intro">
            Full-stack engineer building production SaaS platforms, internal ERPs, and secure web systems.
          </p>

          <div class="hero-actions">
            <a href="https://www.linkedin.com/in/mark-reizel-vincent-palma-903253297/" target="_blank" rel="noopener noreferrer" class="hero-btn linkedin-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
              LinkedIn
            </a>
            <a href="https://github.com/binssente-crypto" target="_blank" rel="noopener noreferrer" class="hero-btn github-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              GitHub
            </a>
            <a href="/learning" class="hero-btn learning-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2l9 4.9V17L12 22 3 17V6.9L12 2z"></path>
              </svg>
              Certifications &amp; PDFs
            </a>
            <a href="/Mark_Reizel_Vincent_Palma_Resume.pdf" download class="hero-btn resume-pdf-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download Resume (PDF)
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Milestones: one row of compact cards -->
    <section class="milestones" aria-labelledby="milestones-heading">
      <h2 id="milestones-heading" class="section-title">Milestones</h2>

      <div class="milestones-grid">
        <!-- Milestone 1: Magna Cum Laude Note -->
        <article class="milestone-card" style="--accent: var(--accent-gold); --accent-text: #92400E;">
          <div class="milestone-meta-row">
            <span class="milestone-pill">Academic Honor • 2026</span>
            <span class="milestone-role">DFCAMCLP</span>
          </div>
          <h3 class="milestone-heading">Magna Cum Laude • BSIS</h3>
          <div class="milestone-location">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
            <span>Dr. Filemon C. Aguilar College</span>
          </div>
          <p class="milestone-desc">
            Graduated with highest academic distinction while architecting enterprise systems and competing in national hackathons.
          </p>
          <div class="milestone-actions">
            <a href="/notes/graduating-magna-cum-laude" class="milestone-btn">
              <span>Read Note</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

        <!-- Milestone 2: eGovPH Hackathon 2026 -->
        <article class="milestone-card" style="--accent: var(--projects); --accent-text: var(--projects-text);">
          <div class="milestone-meta-row">
            <span class="milestone-pill">National Participant • 2026</span>
            <span class="milestone-role">Lead Developer</span>
          </div>
          <h3 class="milestone-heading">eGovPH Hackathon 2026</h3>
          <div class="milestone-location">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Team Println New Gen • SMX Aura</span>
          </div>
          <p class="milestone-desc">
            Engineered a functional public service prototype under 48-hour pressure, integrating national government APIs.
          </p>
          <div class="milestone-actions">
            <a href="/projects/egovph-hackathon-2026" class="milestone-btn">
              <span>Explore Project</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

        <!-- Milestone 3: Cisco Junior Cybersecurity Analyst -->
        <article class="milestone-card" style="--accent: var(--notes); --accent-text: var(--notes-text);">
          <div class="milestone-meta-row">
            <span class="milestone-pill">Cisco Specialization • 2026</span>
            <span class="milestone-role">Blue Team Defense</span>
          </div>
          <h3 class="milestone-heading">Junior Cybersecurity Analyst</h3>
          <div class="milestone-location">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>Cisco Networking Academy • Verified</span>
          </div>
          <p class="milestone-desc">
            In-depth mastery across Network Defense, Endpoint Security, and SOC operations. Dissected live packet captures in Wireshark.
          </p>
          <div class="milestone-actions">
            <a href="/notes/junior-cybersecurity-analyst-journey" class="milestone-btn">
              <span>Read Note</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="/learning#junior-cybersecurity-analyst" class="milestone-secondary-link">
              Certificate
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- Experience | At a glance + Education -->
    <div class="info-grid">
      <section class="info-card" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="section-title">Experience</h2>
        <ul class="info-list">
          <li class="info-row">
            <div class="info-row-head">
              <h3 class="info-heading">Software Development Associate</h3>
              <span class="info-years">June 2026 – Present</span>
            </div>
            <p class="info-company">AAA and Co., CPAs • Full-Time</p>
            <p class="info-note">Architecting Gamma Oracle PM &amp; internal cost control platform.</p>
          </li>
          <li class="info-row">
            <div class="info-row-head">
              <h3 class="info-heading">Software Engineering Intern</h3>
              <span class="info-years">Feb 2026 – June 2026</span>
            </div>
            <p class="info-company">Gamma Oracle Dimension Inc.</p>
            <p class="info-note">Solo developed BizMaker HRIS ERP; co-developed Tax Leaders Circle PH (TLCPH.online).</p>
          </li>
          <li class="info-row">
            <div class="info-row-head">
              <h3 class="info-heading">Freelance Full-Stack Developer</h3>
              <span class="info-years">2024 – Present</span>
            </div>
            <p class="info-company">Self-Employed • Independent Contractor</p>
            <p class="info-note">Shipped custom ERP, POS, and inventory platforms for local businesses.</p>
          </li>
        </ul>
      </section>

      <div class="info-stack">
      <section class="info-card glance-card" aria-labelledby="glance-heading">
        <h2 id="glance-heading" class="section-title">At a glance</h2>
        <dl class="glance-grid">
          {stats.map((s) => (
            <div class="glance-stat" style={`--accent: ${s.accent}`}>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="info-card" aria-labelledby="education-heading">
        <h2 id="education-heading" class="section-title">Education</h2>
        <ul class="info-list">
          <li class="info-row">
            <div class="info-row-head">
              <h3 class="info-heading">B.S. in Information Systems</h3>
              <span class="info-years">2022 – 2026</span>
            </div>
            <p class="info-note">Dr. Filemon C. Aguilar Memorial College of Las Piñas (DFCAMCLP)</p>
          </li>
          <li class="info-row">
            <div class="info-row-head">
              <h3 class="info-heading">De La Salle Santiago Zobel School – BRafeNHS</h3>
              <span class="info-years">2016 – 2022</span>
            </div>
            <p class="info-note">Junior High School (2016–2020) • Senior High School TVL-ICT (2020–2022)</p>
          </li>
        </ul>
      </section>
      </div>
    </div>

    <!-- Route Map & Kanban Skills Matrix -->
    <section class="timeline-section" aria-label="Interactive Journey Route Map">
      <RouteMap />
    </section>
  </main>
</Base>

<style>
.hero-section {
  margin-bottom: var(--space-6);
  padding-bottom: var(--space-6);
  border-bottom: 1px solid var(--border);
}

.hero-profile {
  display: flex;
  gap: var(--space-6);
  align-items: center;
}

@media (max-width: 780px) {
  .hero-profile {
    flex-direction: column;
    text-align: center;
    gap: var(--space-5);
  }
}

.portrait-wrapper {
  flex-shrink: 0;
}

.portrait-img {
  display: block;
  width: 150px;
  height: 150px;
  border-radius: 50%;
  object-fit: cover;
  object-position: top center;
  border: 4px solid var(--surface);
  box-shadow: 0 0 0 1px var(--border), 0 10px 28px rgba(31, 42, 51, 0.14);
  background: var(--surface-2);
  transition: transform 0.25s ease;
}

.portrait-img:hover {
  transform: scale(1.03);
}

.hero-details {
  flex: 1;
  min-width: 0;
}

.name-contact-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-1);
  margin-bottom: var(--space-2);
}

@media (max-width: 780px) {
  .name-contact-row {
    align-items: center;
  }
}

.hero-name {
  margin: 0;
  font-size: clamp(1.8rem, 3.8vw, 2.35rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.15;
}

.contact-strip {
  display: inline-flex;
  gap: var(--space-2) var(--space-5);
  align-items: center;
  flex-wrap: wrap;
}

@media (max-width: 780px) {
  .contact-strip {
    justify-content: center;
  }
}

.contact-item {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--ink-2);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 600;
}

.contact-item svg {
  color: var(--notes);
  flex-shrink: 0;
}

.contact-item:hover {
  color: var(--notes-text);
}

.hero-intro {
  color: var(--ink-2);
  font-size: 1.05rem;
  line-height: 1.5;
  margin: 0 0 var(--space-4);
  max-width: 680px;
}

.hero-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

@media (max-width: 780px) {
  .hero-actions {
    justify-content: center;
  }
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  min-height: 44px;
  padding: 0.55rem 1rem;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.linkedin-btn {
  background: #0A66C2;
  color: #FFF;
}

.linkedin-btn:hover {
  background: #004182;
  color: #FFF;
}

.github-btn {
  background: var(--surface);
  color: var(--ink);
  border-color: var(--border-strong);
}

.github-btn:hover {
  background: var(--ink);
  border-color: var(--ink);
  color: #FFF;
}

.learning-btn {
  background: color-mix(in srgb, var(--learning) 10%, var(--surface));
  color: var(--learning-text);
  border-color: color-mix(in srgb, var(--learning) 35%, transparent);
}

.learning-btn:hover {
  background: color-mix(in srgb, var(--learning) 18%, var(--surface));
  color: var(--learning-text);
}

.resume-pdf-btn {
  background: color-mix(in srgb, var(--projects) 10%, var(--surface));
  color: var(--projects-text);
  border-color: color-mix(in srgb, var(--projects) 35%, transparent);
}

.resume-pdf-btn:hover {
  background: color-mix(in srgb, var(--projects) 18%, var(--surface));
  color: var(--projects-text);
}

/* ---- Shared section title ---- */
.section-title {
  margin: 0 0 var(--space-4);
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.01em;
}

/* ---- Milestones: one row of compact cards ---- */
.milestones {
  margin-bottom: var(--space-5);
}

.milestones-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-4);
}

@media (max-width: 860px) {
  .milestones-grid {
    grid-template-columns: 1fr;
  }
}

.milestone-card {
  display: flex;
  flex-direction: column;
  padding: var(--space-4) var(--space-5) var(--space-5);
  background: var(--surface);
  border: 1px solid var(--border);
  border-top: 3px solid var(--accent);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.milestone-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 1px 2px rgba(31, 42, 51, 0.04), 0 12px 28px color-mix(in srgb, var(--accent) 16%, transparent);
}

.milestone-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
  flex-wrap: wrap;
}

.milestone-pill {
  font-size: 0.68rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 0.15rem 0.45rem;
  border-radius: 4px;
  color: var(--accent-text);
  background: color-mix(in srgb, var(--accent) 10%, var(--surface));
  border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
}

.milestone-role {
  font-size: 0.75rem;
  color: var(--ink-3);
  font-weight: 600;
}

.milestone-heading {
  margin: 0 0 var(--space-1);
  font-size: 1.02rem;
  line-height: 1.25;
}

.milestone-location {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  color: var(--ink-3);
  font-size: 0.78rem;
  margin-bottom: var(--space-2);
}

.milestone-location svg {
  color: var(--accent-text);
  flex-shrink: 0;
}

.milestone-desc {
  flex: 1;
  margin: 0 0 var(--space-4);
  color: var(--ink-2);
  font-size: 0.86rem;
  line-height: 1.5;
}

.milestone-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.milestone-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-height: 36px;
  padding: 0.4rem 0.8rem;
  border-radius: var(--radius-sm);
  background: var(--accent-text);
  color: #FFFFFF;
  font-size: 0.8rem;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.2s ease;
}

.milestone-btn:hover {
  background: color-mix(in srgb, var(--accent-text) 82%, black);
  color: #FFFFFF;
}

.milestone-secondary-link {
  color: var(--ink-2);
  font-size: 0.8rem;
  font-weight: 600;
  text-underline-offset: 2px;
}

.milestone-secondary-link:hover {
  color: var(--ink);
}

/* ---- Education | Experience ---- */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-7);
}

@media (max-width: 860px) {
  .info-grid {
    grid-template-columns: 1fr;
  }
}

.info-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.info-card {
  padding: var(--space-5);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.info-card .section-title {
  margin-bottom: var(--space-2);
}

.info-list {
  margin: 0;
  padding: 0;
  list-style: none;
}

.info-row {
  padding: var(--space-3) 0;
}

.info-row + .info-row {
  border-top: 1px solid var(--border);
}

.info-row:last-child {
  padding-bottom: 0;
}

.info-row-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
  margin-bottom: 0.15rem;
}

.info-heading {
  margin: 0;
  font-size: 0.97rem;
  line-height: 1.3;
}

.info-years {
  color: var(--ink-3);
  font-size: 0.8rem;
  font-weight: 600;
  white-space: nowrap;
}

.info-company {
  margin: 0 0 0.15rem;
  color: var(--notes-text);
  font-size: 0.85rem;
  font-weight: 600;
}

.info-note {
  margin: 0;
  color: var(--ink-2);
  font-size: 0.85rem;
  line-height: 1.45;
}

/* ---- At a glance ---- */
.glance-card {
  flex: 1; /* fills the left column down to the bottom of Experience */
  display: flex;
  flex-direction: column;
}

.glance-grid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-3);
  margin: var(--space-2) 0 0;
}

@media (max-width: 520px) {
  .glance-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.glance-stat {
  display: flex;
