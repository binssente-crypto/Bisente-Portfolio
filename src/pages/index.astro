---
import Base from '../layouts/Base.astro';
import RouteMap from '../components/RouteMap.astro';
---

<Base title="Mark Reizel Vincent C. Palma | Full-Stack Engineer & Software Developer">
  <main class="portfolio-container">
    <header class="hero-section">
      <div class="hero-profile">
        <div class="portrait-wrapper">
          <img 
            src="/images/profile.png" 
            alt="Mark Reizel Vincent C. Palma in graduation toga" 
            class="portrait-img"
            width="190"
            height="190"
          />
        </div>

        <div class="hero-details">
          <!-- Name and Contact Info Row -->
          <div class="name-contact-row">
            <h1 class="hero-name">Mark Reizel Vincent C. Palma</h1>
            <div class="contact-strip">
              <a href="mailto:binssente@gmail.com" class="contact-item" title="Send email">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <span>binssente@gmail.com</span>
              </a>
              <a href="tel:+639158057972" class="contact-item" title="Call phone number">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <span>+63 915 805 7972</span>
              </a>
            </div>
          </div>

          <!-- LinkedIn-style entry placed directly below the name -->
          <div class="linkedin-headline">
            <span class="role-badge">SOFTWARE DEVELOPMENT ASSOCIATE</span>
            <span class="company-tag">AAA and Co., CPAs</span>
          </div>

          <p class="hero-intro">
            Full-stack engineer building production SaaS platforms, internal ERPs, and secure web systems.
          </p>

          <div class="education-card">
            <div class="edu-item">
              <div class="edu-header">
                <span class="honor-pill">Magna Cum Laude</span>
                <span class="edu-degree">B.S. in Information Systems</span>
                <span class="edu-years">2022 – 2026</span>
              </div>
              <p class="edu-school">Dr. Filemon C. Aguilar Memorial College of Las Piñas (DFCAMCLP)</p>
            </div>
            <div class="edu-divider"></div>
            <div class="edu-item hs-item">
              <div class="edu-header">
                <span class="hs-track">TVL-ICT Track</span>
                <span class="edu-school-name">De La Salle Santiago Zobel School – BRafeNHS</span>
                <span class="edu-years">2016 – 2022</span>
              </div>
              <p class="hs-note">Junior High School (2016–2020) • Senior High School TVL-ICT (2020–2022)</p>
            </div>
          </div>

          <!-- Hero Actions: Cleaned up (no Credly badge button, no web version button) -->
          <div class="hero-actions">
            <a href="https://www.linkedin.com/in/mark-reizel-vincent-palma-903253297/" target="_blank" rel="noopener noreferrer" class="hero-btn linkedin-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
              LinkedIn
            </a>
            <a href="https://github.com/binssente-crypto" target="_blank" rel="noopener noreferrer" class="hero-btn github-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              GitHub
            </a>
            <a href="/learning" class="hero-btn learning-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2l9 4.9V17L12 22 3 17V6.9L12 2z"></path>
              </svg>
              Certifications &amp; PDFs
            </a>
            <a href="/Mark_Reizel_Vincent_Palma_Resume.pdf" download class="hero-btn resume-pdf-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download Resume (PDF)
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Flagship Milestones Spotlight -->
    <section class="flagship-section" aria-label="Flagship Milestones">
      <div class="flagship-header">
        <div class="flagship-badge-tag">
          <span class="pulse-dot"></span>
          CROWNING MILESTONES &amp; RECOGNITION
        </div>
        <h2 class="flagship-title">Flagship Highlights</h2>
        <p class="flagship-subtitle">
          Key national competition finalist achievement and comprehensive industry cybersecurity career path.
        </p>
      </div>

      <div class="flagship-grid">
        <!-- Milestone 1: eGovPH Hackathon 2026 -->
        <article class="milestone-card egov-card">
          <div class="card-glow-edge gold-glow"></div>
          <div class="card-inner">
            <div class="milestone-meta-row">
              <span class="milestone-pill gold-pill">National Finalist • 2026</span>
              <span class="milestone-role">Lead Developer</span>
            </div>
            <h3 class="milestone-heading">eGovPH National Hackathon 2026</h3>
            <div class="milestone-location">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>5-Member Team "Println New Gen" • SMX Convention Center Aura, BGC</span>
            </div>
            <p class="milestone-desc">
              Engineered a functional public service prototype under 48-hour pressure, integrating national government digital infrastructure including <strong>eGov SSO</strong>, <strong>eVerify</strong>, and <strong>eGovPay</strong> APIs.
            </p>
            <div class="milestone-actions">
              <a href="/projects/egovph-hackathon-2026" class="milestone-btn primary-milestone-btn">
                <span>Explore Project &amp; Photos</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Milestone 2: Cisco Junior Cybersecurity Analyst -->
        <article class="milestone-card cyber-card">
          <div class="card-glow-edge cyan-glow"></div>
          <div class="card-inner">
            <div class="milestone-meta-row">
              <span class="milestone-pill cyan-pill">Cisco Specialization • 2026</span>
              <span class="milestone-role">Blue Team Defense</span>
            </div>
            <h3 class="milestone-heading">Junior Cybersecurity Analyst Career Path</h3>
            <div class="milestone-location">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>Cisco Networking Academy • Verified Credential &amp; Portfolio Defense</span>
            </div>
            <p class="milestone-desc">
              In-depth mastery across Network Defense, Endpoint Security, and SOC operations. Dissected live packet captures in Wireshark and translated zero-trust principles into hardened web application code.
            </p>
            <div class="milestone-actions">
              <a href="/notes/junior-cybersecurity-analyst-journey" class="milestone-btn cyber-milestone-btn">
                <span>Read "Behind the Blue Team"</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
              <a href="/learning#junior-cybersecurity-analyst" class="milestone-secondary-link">
                View Certificate
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- Route Map & Kanban Skills Matrix -->
    <section class="timeline-section" aria-label="Interactive Journey Route Map">
      <RouteMap />
    </section>
  </main>
</Base>

<style>
.portfolio-container {
  max-width: 1040px;
  margin: 0 auto;
}

.hero-section {
  margin-bottom: 2.5rem;
  padding-bottom: 2.5rem;
  border-bottom: 1px solid var(--rail);
}

.hero-profile {
  display: flex;
  gap: 2.25rem;
  align-items: flex-start;
}

@media (max-width: 780px) {
  .hero-profile {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
}

.portrait-wrapper {
  flex-shrink: 0;
  position: relative;
}

.portrait-img {
  width: 190px;
  height: 190px;
  border-radius: 50%;
  object-fit: cover;
  object-position: top center;
  border: 3px solid rgba(0, 229, 255, 0.45);
  box-shadow: 0 0 24px rgba(0, 229, 255, 0.22), 0 8px 30px rgba(0, 0, 0, 0.7);
  display: block;
  background: var(--surface-2);
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.portrait-img:hover {
  transform: scale(1.03);
  border-color: rgba(0, 229, 255, 0.8);
  box-shadow: 0 0 35px rgba(0, 229, 255, 0.4), 0 12px 35px rgba(0, 0, 0, 0.85);
}

.hero-details {
  flex: 1;
  min-width: 0;
}

/* Name and Contact Strip Header Row */
.name-contact-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem 1.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.25rem;
}

@media (max-width: 780px) {
  .name-contact-row {
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
}

.hero-name {
  margin: 0;
  font-size: clamp(1.8rem, 3.8vw, 2.35rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--ink);
  line-height: 1.15;
}

.contact-strip {
  display: inline-flex;
  gap: 1.25rem;
  align-items: center;
  flex-wrap: wrap;
}

@media (max-width: 780px) {
  .contact-strip {
    justify-content: center;
  }
}

.contact-item {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--ink-2);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.contact-item svg {
  color: var(--notes);
  flex-shrink: 0;
}

.contact-item:hover {
  color: var(--notes-text);
  text-decoration: none;
}

/* LinkedIn-style Entry placed right underneath the name */
.linkedin-headline {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin: 0.4rem 0 0.85rem;
  flex-wrap: wrap;
}

@media (max-width: 780px) {
  .linkedin-headline {
    justify-content: center;
  }
}

.role-badge {
  background: rgba(0, 229, 255, 0.12);
  color: var(--notes);
  border: 1px solid rgba(0, 229, 255, 0.35);
  padding: 0.22rem 0.65rem;
  border-radius: 4px;
  font-size: 0.8rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  box-shadow: 0 0 10px rgba(0, 229, 255, 0.15);
}

.company-tag {
  color: #CBD5E1;
  font-weight: 600;
  font-size: 0.95rem;
}

.hero-intro {
  color: var(--ink-2);
  font-size: 1.05rem;
  line-height: 1.5;
  margin: 0 0 1.25rem;
  max-width: 680px;
}

/* Cyber styled Education Card */
.education-card {
  background: var(--surface-card);
  border: 1px solid var(--rail);
  border-radius: 8px;
  padding: 1rem 1.25rem;
  margin-bottom: 1.5rem;
  text-align: left;
  backdrop-filter: blur(8px);
}

.edu-item {
  display: flex;
  flex-direction: column;
}

.edu-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
}

.honor-pill {
  background: rgba(255, 215, 0, 0.15);
  color: #FFD700;
  border: 1px solid rgba(255, 215, 0, 0.35);
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  font-weight: 800;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.edu-degree {
  font-weight: 700;
  color: var(--ink);
  font-size: 0.95rem;
}

.edu-years {
  margin-left: auto;
  color: var(--ink-3);
  font-size: 0.85rem;
  font-weight: 600;
}

.edu-school {
  margin: 0.3rem 0 0;
  color: var(--ink-2);
  font-size: 0.9rem;
}

.edu-divider {
  height: 1px;
  background: var(--rail);
  margin: 0.75rem 0;
}

.hs-item .edu-header {
  font-size: 0.9rem;
}

.hs-track {
  background: rgba(0, 229, 255, 0.1);
  color: var(--notes);
  border: 1px solid rgba(0, 229, 255, 0.25);
  padding: 0.15rem 0.45rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 700;
}

.edu-school-name {
  font-weight: 600;
  color: var(--ink);
}

.hs-note {
  margin: 0.25rem 0 0;
  font-size: 0.825rem;
  color: var(--ink-2);
}

/* Hero Actions */
.hero-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

@media (max-width: 780px) {
  .hero-actions {
    justify-content: center;
  }
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.55rem 1rem;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
}

.linkedin-btn {
  background: #0A66C2;
  color: #FFF;
  border: 1px solid rgba(10, 102, 194, 0.5);
}

.linkedin-btn:hover {
  background: #004182;
  color: #FFF;
  box-shadow: 0 0 14px rgba(10, 102, 194, 0.5);
}

.github-btn {
  background: var(--surface-2);
  color: var(--ink);
  border: 1px solid var(--rail-light);
}

.github-btn:hover {
  background: #1F2C46;
  border-color: var(--notes);
  color: #FFF;
}

.learning-btn {
  background: rgba(0, 255, 157, 0.12);
  color: var(--learning-text);
  border: 1px solid rgba(0, 255, 157, 0.35);
}

.learning-btn:hover {
  background: rgba(0, 255, 157, 0.22);
  box-shadow: 0 0 16px rgba(0, 255, 157, 0.3);
}

.resume-pdf-btn {
  background: rgba(255, 107, 0, 0.15);
  color: var(--projects-text);
  border: 1px solid rgba(255, 107, 0, 0.4);
}

.resume-pdf-btn:hover {
  background: rgba(255, 107, 0, 0.25);
  box-shadow: 0 0 16px rgba(255, 107, 0, 0.3);
}

/* =====================================================================
   FLAGSHIP MILESTONES SHOWCASE
   ===================================================================== */
.flagship-section {
  margin-bottom: 3.5rem;
  padding: 1.75rem 2rem;
  background: rgba(13, 19, 34, 0.6);
  border: 1px solid var(--rail);
  border-radius: 12px;
  position: relative;
  backdrop-filter: blur(10px);
}

.flagship-header {
  margin-bottom: 1.75rem;
}

.flagship-badge-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: var(--accent-gold);
  margin-bottom: 0.4rem;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-gold);
  box-shadow: 0 0 10px var(--accent-gold);
  animation: pulse-glow 2s infinite ease-in-out;
}

@keyframes pulse-glow {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}

.flagship-title {
  margin: 0.2rem 0 0.4rem;
  font-size: 1.55rem;
  color: var(--ink);
  letter-spacing: -0.01em;
}

.flagship-subtitle {
  margin: 0;
  color: var(--ink-2);
  font-size: 0.95rem;
}

.flagship-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

@media (max-width: 860px) {
  .flagship-grid {
    grid-template-columns: 1fr;
  }
}

.milestone-card {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--rail);
  border-radius: 10px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.milestone-card:hover {
  transform: translateY(-3px);
}

.egov-card:hover {
  border-color: rgba(255, 215, 0, 0.4);
  box-shadow: 0 8px 30px rgba(255, 215, 0, 0.12);
}

.cyber-card:hover {
  border-color: rgba(0, 229, 255, 0.4);
  box-shadow: 0 8px 30px rgba(0, 229, 255, 0.12);
}

.card-glow-edge {
  height: 3px;
  width: 100%;
}

.gold-glow {
  background: linear-gradient(90deg, #FFD700, #FF6B00);
}

.cyan-glow {
  background: linear-gradient(90deg, #00E5FF, #00FF9D);
}

.card-inner {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.milestone-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
  flex-wrap: wrap;
}

.milestone-pill {
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.2rem 0.55rem;
  border-radius: 4px;
}

.gold-pill {
  background: rgba(255, 215, 0, 0.15);
  color: #FFD700;
  border: 1px solid rgba(255, 215, 0, 0.35);
}

.cyan-pill {
  background: rgba(0, 229, 255, 0.12);
  color: #00E5FF;
  border: 1px solid rgba(0, 229, 255, 0.35);
}

.milestone-role {
  font-size: 0.8rem;
  color: var(--ink-3);
  font-weight: 600;
}

.milestone-heading {
  margin: 0 0 0.5rem;
  font-size: 1.25rem;
  color: var(--ink);
  line-height: 1.25;
}

.milestone-location {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--ink-2);
  font-size: 0.85rem;
  margin-bottom: 0.85rem;
}

.milestone-location svg {
  color: var(--notes);
  flex-shrink: 0;
}

.milestone-desc {
  color: var(--ink-2);
  font-size: 0.925rem;
  line-height: 1.55;
  margin: 0 0 1.25rem;
  flex: 1;
}

.milestone-actions {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  flex-wrap: wrap;
  margin-top: auto;
}

.milestone-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.5rem 0.9rem;
  border-radius: 6px;
  font-size: 0.875rem;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.2s ease;
}

.primary-milestone-btn {
  background: rgba(255, 215, 0, 0.15);
  color: #FFD700;
  border: 1px solid rgba(255, 215, 0, 0.4);
}

.primary-milestone-btn:hover {
  background: rgba(255, 215, 0, 0.25);
  box-shadow: 0 0 14px rgba(255, 215, 0, 0.3);
  color: #FFF;
}

.cyber-milestone-btn {
  background: rgba(0, 229, 255, 0.15);
  color: #00E5FF;
  border: 1px solid rgba(0, 229, 255, 0.4);
}

.cyber-milestone-btn:hover {
  background: rgba(0, 229, 255, 0.25);
  box-shadow: 0 0 14px rgba(0, 229, 255, 0.3);
  color: #FFF;
}

