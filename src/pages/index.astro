---
import Base from '../layouts/Base.astro';
import RouteMap from '../components/RouteMap.astro';
---

<Base title="Mark Reizel Vincent C. Palma | Full-Stack Engineer & Software Developer">
  <main class="portfolio-container">
    <header class="hero-section">
      <div class="hero-profile">
        <div class="portrait-wrapper">
          <img 
            src="/images/profile.png" 
            alt="Mark Reizel Vincent C. Palma in graduation toga" 
            class="portrait-img"
            width="140"
            height="140"
          />
        </div>
        <div class="hero-details">
          <div class="hero-meta">
            <span class="role-badge">Software Development Associate</span>
            <span class="company-tag">AAA and Co., CPAs</span>
          </div>
          <h1 class="hero-name">Mark Reizel Vincent C. Palma</h1>
          <p class="hero-intro">
            Full-stack engineer building production SaaS platforms, internal ERPs, and secure web systems.
          </p>

          <div class="education-card">
            <div class="edu-item">
              <div class="edu-header">
                <span class="honor-pill">Magna Cum Laude</span>
                <span class="edu-degree">B.S. in Information Systems</span>
                <span class="edu-years">2022 – 2026</span>
              </div>
              <p class="edu-school">Dr. Filemon C. Aguilar Memorial College of Las Piñas (DFCAMCLP)</p>
            </div>
            <div class="edu-divider"></div>
            <div class="edu-item hs-item">
              <div class="edu-header">
                <span class="hs-track">TVL-ICT Track</span>
                <span class="edu-school-name">De La Salle Santiago Zobel School – BRafeNHS</span>
                <span class="edu-years">2016 – 2022</span>
              </div>
              <p class="hs-note">Junior High School (2016–2020) • Senior High School TVL-ICT (2020–2022)</p>
            </div>
          </div>

          <div class="contact-strip">
            <a href="mailto:binssente@gmail.com" class="contact-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>binssente@gmail.com</span>
            </a>
            <a href="tel:+639158057972" class="contact-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>+63 915 805 7972</span>
            </a>
          </div>

          <div class="hero-actions">
            <a href="https://www.linkedin.com/in/mark-reizel-vincent-palma-903253297/" target="_blank" rel="noopener noreferrer" class="hero-btn linkedin-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
              LinkedIn
            </a>
            <a href="https://github.com/binssente-crypto" target="_blank" rel="noopener noreferrer" class="hero-btn primary-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              GitHub
            </a>
            <a href="https://www.credly.com/users/vincent-palma/badges" target="_blank" rel="noopener noreferrer" class="hero-btn credly-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              17 Cisco Badges
            </a>
            <a href="/learning" class="hero-btn learning-btn">
              Certifications & PDFs
            </a>
            <a href="/Mark_Reizel_Vincent_Palma_Resume.pdf" download class="hero-btn resume-pdf-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download Resume (PDF)
            </a>
            <a href="/resume" class="hero-btn view-resume-btn">
              View Web Version
            </a>
          </div>
        </div>
      </div>
    </header>

    <section class="timeline-section" aria-label="Interactive Journey Route Map">
      <RouteMap />
    </section>
  </main>
</Base>

<style>
.portfolio-container {
  max-width: 1040px;
  margin: 0 auto;
}
.hero-section {
  margin-bottom: 3rem;
  padding-bottom: 2.5rem;
  border-bottom: 1px solid var(--rail);
}
.hero-profile {
  display: flex;
  gap: 2rem;
  align-items: flex-start;
}
@media (max-width: 720px) {
  .hero-profile {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
}
.portrait-wrapper {
  flex-shrink: 0;
}
.portrait-img {
  width: 130px;
  height: 130px;
  border-radius: 50%;
  object-fit: cover;
  object-position: top center;
  border: 3px solid #FFF;
  box-shadow: 0 4px 14px rgba(15, 34, 51, 0.15);
  display: block;
}
.hero-details {
  flex: 1;
}
.hero-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.5rem;
  flex-wrap: wrap;
}
@media (max-width: 720px) {
  .hero-meta {
    justify-content: center;
  }
}
.role-badge {
  background: var(--ink);
  color: #FFF;
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.company-tag {
  color: var(--ink-2);
  font-weight: 600;
  font-size: 0.9rem;
}
.hero-name {
  margin: 0.25rem 0 0.5rem;
  font-size: clamp(1.8rem, 4vw, 2.5rem);
  letter-spacing: -0.02em;
}
.hero-intro {
  color: var(--ink-2);
  font-size: 1.05rem;
  line-height: 1.5;
  margin: 0 0 1.25rem;
  max-width: 620px;
}
.education-card {
  background: #FFF;
  border: 1px solid var(--rail);
  border-radius: 8px;
  padding: 1rem 1.25rem;
  margin-bottom: 1.5rem;
  text-align: left;
}
.edu-item {
  display: flex;
  flex-direction: column;
}
.edu-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
}
.honor-pill {
  background: #FEF3C7;
  color: #92400E;
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  font-weight: 800;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.edu-degree {
  font-weight: 700;
  color: var(--ink);
  font-size: 0.95rem;
}
.edu-years {
  margin-left: auto;
  color: var(--ink-2);
  font-size: 0.85rem;
  font-weight: 600;
}
.edu-school {
  margin: 0.25rem 0 0;
  color: var(--ink-2);
  font-size: 0.9rem;
}
.edu-divider {
  height: 1px;
  background: var(--rail);
  margin: 0.75rem 0;
}
.hs-item .edu-header {
  font-size: 0.9rem;
}
.hs-track {
  background: var(--paper);
  color: var(--ink);
  padding: 0.15rem 0.45rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
}
.edu-school-name {
  font-weight: 600;
  color: var(--ink);
}
.hs-note {
  margin: 0.2rem 0 0;
  font-size: 0.825rem;
  color: var(--ink-2);
}
.contact-strip {
  display: flex;
  gap: 1.25rem;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
}
@media (max-width: 720px) {
  .contact-strip {
    justify-content: center;
  }
}
.contact-item {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--ink-2);
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 600;
  transition: color 0.15s ease;
}
.contact-item:hover {
  color: var(--ink);
  text-decoration: underline;
}
.hero-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}
@media (max-width: 720px) {
  .hero-actions {
    justify-content: center;
  }
}
.linkedin-btn {
  background: #0A66C2;
  color: #FFF;
}
.linkedin-btn:hover {
  background: #004182;
}
.hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.5rem 0.9rem;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.15s ease;
}
.primary-btn {
  background: var(--ink);
  color: #FFF;
}
.primary-btn:hover {
  background: #1b3752;
}
.credly-btn {
  background: #ff6f00;
  color: #FFF;
}
.credly-btn:hover {
  opacity: 0.92;
}
.learning-btn {
  background: #FFF;
  color: var(--ink);
  border: 1px solid var(--rail);
}
.learning-btn:hover {
  background: var(--paper);
  border-color: var(--ink-2);
}
.resume-pdf-btn {
  background: var(--projects);
  color: #FFF;
}
.resume-pdf-btn:hover {
  background: #b54f00;
}
.view-resume-btn {
  background: #FFF;
  color: var(--ink);
  border: 1px solid var(--rail);
}
.view-resume-btn:hover {
  background: var(--paper);
  border-color: var(--ink-2);
}
.timeline-section {
  margin-top: 1rem;
}
</style>
